<resources>
    <!-- Base application theme. -->
    <style name="Theme.MoneyTracker" parent="Theme.MaterialComponents.DayNight.DarkActionBar">

        <item name="colorPrimary">@color/azure_blue</item>
        <item name="colorPrimaryVariant">@color/emerald_green</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/teal</item>
        <item name="colorSecondaryVariant">@color/dark_teal</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar background -->
        <item name="android:statusBarColor">@color/vibrant_orange</item>

        <!-- THIS makes icons WHITE -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <item name="android:navigationBarColor">@color/vibrant_orange</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:forceDarkAllowed">false</item>

        <item name="emptyArchive">@drawable/empty_archive_night</item>
        <item name="emptyBudget">@drawable/empty_budget_night</item>
        <item name="emptyCategory">@drawable/empty_category_night</item>
        <item name="emptyCurrency">@drawable/empty_currency_night</item>
        <item name="emptyDebt">@drawable/empty_debt_night</item>
        <item name="emptyGoal">@drawable/empty_goal_night</item>
        <item name="emptyRecord">@drawable/empty_record_night</item>
        <item name="emptyRecurring">@drawable/empty_recurring_night</item>
        <item name="emptySearch">@drawable/empty_search_night</item>
    </style>
</resources>