<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/edit_text_height_48"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/corner_radius_6"
    app:cardElevation="0dp"
    app:strokeColor="@color/color_matte_black"
    app:strokeWidth="0.8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Manage Google Play Text -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvManageGooglePlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_google_play"
            android:drawablePadding="@dimen/padding_2"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/manage_google_play"
            android:textColor="@color/black"
            android:textSize="@dimen/text_12"
            app:fontFamily="@font/exo2_semibold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Open in New Icon -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivOpenNew"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="@dimen/margin_10"
            android:contentDescription="@null"
            android:padding="@dimen/padding_6"
            android:src="@drawable/ic_open_new"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>