<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_light_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/vibrant_orange"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include layout="@layout/toolbar_back" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/btnUpgradePro"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarWrapper">

        <LinearLayout
            android:id="@+id/topWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_6"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:paddingTop="@dimen/padding_8"
                android:paddingBottom="@dimen/padding_8">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivUpgradePremium"
                    android:layout_width="120dp"
                    android:layout_height="100dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_upgrade_premium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/layoutDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_8"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ivUpgradePremium"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Premium badge -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_white"
                        android:backgroundTint="@color/light_lavender"
                        android:drawableStart="@drawable/ic_premium"
                        android:drawablePadding="@dimen/padding_2"
                        android:drawableTint="@color/primary_dark"
                        android:gravity="center"
                        android:minHeight="24dp"
                        android:paddingStart="@dimen/padding_6"
                        android:paddingTop="3dp"
                        android:paddingEnd="@dimen/padding_8"
                        android:paddingBottom="3dp"
                        android:text="@string/premium"
                        android:textColor="@color/primary_dark"
                        android:textSize="@dimen/text_10"
                        app:fontFamily="@font/exo2_semibold" />

                    <!-- Title -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/lblTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_6"
                        android:text="@string/take_control_finances"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_18"
                        app:fontFamily="@font/exo2_bold" />

                    <!-- Description -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/lblDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_6"
                        android:text="@string/premium_desc"
                        android:textColor="@color/dark_grey"
                        android:textSize="@dimen/text_10"
                        app:fontFamily="@font/exo2_medium" />

                    <!-- Features -->
                    <LinearLayout
                        android:id="@+id/layoutFeatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_10"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/margin_14">

                        <!-- Left -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.7"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/featureWallet"
                                layout="@layout/item_feature_upgrade" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/margin_6"
                            android:layout_marginBottom="@dimen/margin_6"
                            android:background="@color/light_lavender" />

                        <!-- Center -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.7"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/featureCloud"
                                layout="@layout/item_feature_upgrade" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/margin_6"
                            android:layout_marginBottom="@dimen/margin_6"
                            android:background="@color/light_lavender" />

                        <!-- Right -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.7"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/featureOthers"
                                layout="@layout/item_feature_upgrade" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <include
                layout="@layout/layout_pro_subscription_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16" />

            <include
                layout="@layout/layout_pro_features_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_10" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUpgradePro"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="@dimen/margin_16"
        android:layout_marginEnd="@dimen/margin_16"
        android:alpha="0.5"
        android:drawableTint="@color/white"
        android:enabled="false"
        android:fontFamily="@font/exo2_semibold"
        android:letterSpacing="0.01"
        android:text="@string/continue_pro"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="@dimen/text_14"
        app:backgroundTint="@color/primary"
        app:cornerRadius="@dimen/corner_radius_8"
        app:elevation="@dimen/corner_elevation_8"
        app:icon="@drawable/ic_arrow_right"
        app:iconGravity="textEnd"
        app:iconPadding="12dp"
        app:iconSize="18dp"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/lblUpgradeHint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/lblUpgradeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_10"
        android:layout_weight="1"
        android:drawablePadding="@dimen/padding_2"
        android:drawableTint="@color/dark_grey"
        android:gravity="center"
        android:text="@string/subscription_renews_desc"
        android:textColor="@color/dark_grey"
        android:textSize="@dimen/text_8"
        app:fontFamily="@font/exo2_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>