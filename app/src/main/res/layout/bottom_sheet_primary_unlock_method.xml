<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_16"
        android:fontFamily="@font/exo2_bold"
        android:text="@string/primary_unlock_method"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSubHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_6"
        android:fontFamily="@font/exo2_medium"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHeader" />

    <View
        android:id="@+id/viewDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/margin_10"
        android:background="@color/light_grey"
        app:layout_constraintTop_toBottomOf="@+id/tvSubHeader" />

    <!-- Auto-lock options -->
    <RadioGroup
        android:id="@+id/rgPrimaryUnlockMethod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/padding_10"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewDivider">

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/rbPrimaryPassword"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_48"
            android:buttonTint="@color/vibrant_orange"
            android:fontFamily="@font/exo2_medium"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/padding_4"
            android:text="@string/password"
            android:textColor="@color/color_matte_black"
            android:textSize="@dimen/text_14" />

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/rbPrimaryPin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_48"
            android:buttonTint="@color/vibrant_orange"
            android:fontFamily="@font/exo2_medium"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/padding_4"
            android:text="@string/text_pin"
            android:textColor="@color/color_matte_black"
            android:textSize="@dimen/text_14" />

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/rbPrimaryFingerprint"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_48"
            android:buttonTint="@color/vibrant_orange"
            android:fontFamily="@font/exo2_medium"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/padding_4"
            android:text="@string/fingerprint"
            android:textColor="@color/color_matte_black"
            android:textSize="@dimen/text_14" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_20"
        android:layout_marginTop="@dimen/margin_12"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rgPrimaryUnlockMethod">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/edit_text_height_56"
            android:layout_marginEnd="@dimen/margin_6"
            android:layout_weight="1"
            android:backgroundTint="@color/very_light_lavender"
            android:fontFamily="@font/exo2_semibold"
            android:letterSpacing="0.01"
            android:text="@string/apply"
            android:textAllCaps="true"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_14"
            app:cornerRadius="@dimen/corner_radius_4"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/edit_text_height_56"
            android:layout_marginStart="@dimen/margin_6"
            android:layout_weight="1"
            android:backgroundTint="@color/very_light_expense"
            android:fontFamily="@font/exo2_semibold"
            android:letterSpacing="0.01"
            android:text="@string/reset"
            android:textAllCaps="true"
            android:textColor="@color/bright_red"
            android:textSize="@dimen/text_14"
            app:cornerRadius="@dimen/corner_radius_4"
            app:strokeColor="@color/bright_red"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/margin_8"
        android:layout_marginBottom="@dimen/margin_12"
        android:fontFamily="@font/exo2_semibold"
        android:gravity="center"
        android:text="@string/text_close"
        android:textAllCaps="true"
        android:textColor="@color/primary_dark"
        android:textSize="@dimen/text_16"
        app:fontFamily="@font/exo2_semibold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActions" />
</androidx.constraintlayout.widget.ConstraintLayout>