<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/corner_radius_4"
            app:cardElevation="0dp"
            app:strokeColor="@color/light_lavender"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Table header -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:background="@color/white"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="220dp"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/exo2_semibold"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/padding_18"
                        android:paddingEnd="@dimen/padding_10"
                        android:text="@string/features"
                        android:textColor="@color/color_matte_black"
                        android:textSize="@dimen/text_16" />

                    <LinearLayout
                        android:layout_width="140dp"
                        android:layout_height="match_parent"
                        android:background="@color/pale_lavendar"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/exo2_semibold"
                            android:text="@string/free_plan"
                            android:textColor="@color/grayish_purple"
                            android:textSize="@dimen/text_14" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="140dp"
                        android:layout_height="match_parent"
                        android:background="@color/light_lavender"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/exo2_semibold"
                            android:text="@string/pro_plan"
                            android:textColor="@color/vibrant_orange"
                            android:textSize="@dimen/text_14" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/lavendar_web" />

                <!-- Feature rows -->
                <LinearLayout
                    android:id="@+id/featureRowsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </HorizontalScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>