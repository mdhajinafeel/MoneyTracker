<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_light_background">

    <!-- Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/vibrant_orange"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar_back" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarWrapper">

        <LinearLayout
            android:id="@+id/topWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_6"
            android:orientation="vertical"
            android:paddingStart="@dimen/padding_18"
            android:paddingTop="@dimen/padding_12"
            android:paddingEnd="@dimen/padding_18"
            android:paddingBottom="@dimen/padding_18">

            <!-- Header illustration -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivPinHeader"
                android:layout_width="180dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_setting_password_pin" />

            <!-- Main heading -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPinHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_4"
                android:gravity="center"
                android:text="@string/create_digit_pin"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_18"
                app:fontFamily="@font/exo2_bold" />

            <!-- Subtitle -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCreatePinHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_12"
                android:layout_marginTop="@dimen/margin_8"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/create_pin_hint"
                android:textColor="@color/primary_light"
                android:textSize="@dimen/text_12"
                app:fontFamily="@font/exo2_medium" />

            <!-- Six PIN indicators -->
            <LinearLayout
                android:id="@+id/pinIndicatorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/pinDot1"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/bg_pin_dot" />

                <View
                    android:id="@+id/pinDot2"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/bg_pin_dot" />

                <View
                    android:id="@+id/pinDot3"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/bg_pin_dot" />

                <View
                    android:id="@+id/pinDot4"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/bg_pin_dot" />

                <View
                    android:id="@+id/pinDot5"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/bg_pin_dot" />

                <View
                    android:id="@+id/pinDot6"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/bg_pin_dot" />

            </LinearLayout>

            <!-- Numeric keypad -->
            <GridLayout
                android:id="@+id/pinKeypad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_26"
                android:alignmentMode="alignMargins"
                android:columnCount="3"
                android:columnOrderPreserved="false"
                android:rowCount="4"
                android:useDefaultMargins="false">

                <!-- Row 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/key1"
                    style="@style/PinKeyStyle">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/number_1"
                        android:textColor="#17134B"
                        android:textSize="25sp"
                        app:fontFamily="@font/exo2_semibold" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/key2"
                    style="@style/PinKeyStyle">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/number_2"
                        android:textColor="#17134B"
                        android:textSize="25sp"
                        app:fontFamily="@font/exo2_semibold" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/key3"
                    style="@style/PinKeyStyle">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/number_3"
                        android:textColor="#17134B"
                        android:textSize="25sp"
                        app:fontFamily="@font/exo2_semibold" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Row 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/key4"
                    style="@style/PinKeyStyle">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/number_4"
                        android:textColor="#17134B"
                        android:textSize="25sp"
                        app:fontFamily="@font/exo2_semibold" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/key5"
                    style="@style/PinKeyStyle">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/number_5"
                        android:textColor="#17134B"
                        android:textSize="25sp"
                        app:fontFamily="@font/exo2_semibold" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/key6"
                    style="@style/PinKeyStyle">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/number_6"
                        android:textColor="#17134B"
                        android:textSize="25sp"
                        app:fontFamily="@font/exo2_semibold" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Row 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/key7"
                    style="@style/PinKeyStyle">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/number_7"
                        android:textColor="#17134B"
                        android:textSize="25sp"
                        app:fontFamily="@font/exo2_semibold" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/key8"
                    style="@style/PinKeyStyle">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/number_8"
                        android:textColor="#17134B"
                        android:textSize="25sp"
                        app:fontFamily="@font/exo2_semibold" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/key9"
                    style="@style/PinKeyStyle">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/number_9"
                        android:textColor="#17134B"
                        android:textSize="25sp"
                        app:fontFamily="@font/exo2_semibold" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Row 4: empty, zero, delete -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/key0"
                    style="@style/PinKeyStyle">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/number_0"
                        android:textColor="#17134B"
                        android:textSize="@dimen/text_24"
                        app:fontFamily="@font/exo2_semibold" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/keyDelete"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#F0EBFF"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/delete_last_digit"
                        android:src="@drawable/ic_escape"
                        app:tint="#17134B" />

                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <!-- PIN requirements -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPinRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20"
                app:cardBackgroundColor="@color/app_light_background"
                app:cardCornerRadius="@dimen/corner_radius_16"
                app:cardElevation="0dp"
                app:strokeColor="@color/primary_light"
                app:strokeWidth="0.4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_18">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pin_requirements"
                        android:textColor="@color/primary_dark"
                        android:textSize="@dimen/text_16"
                        app:fontFamily="@font/exo2_bold" />

                    <!-- Requirement 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivRequirementLength"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_complete"
                            app:tint="@color/primary_dark" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvRequirementLength"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_6"
                            android:layout_weight="1"
                            android:text="@string/must_exactly_digits"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_12"
                            app:fontFamily="@font/exo2_medium" />
                    </LinearLayout>

                    <!-- Requirement 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivRequirementLetter"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_complete"
                            app:tint="@color/primary_dark" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvRequirementLetter"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_6"
                            android:layout_weight="1"
                            android:text="@string/use_numbers_only"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_12"
                            app:fontFamily="@font/exo2_medium" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreatePin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="@dimen/margin_12"
                android:fontFamily="@font/exo2_semibold"
                android:letterSpacing="0.01"
                android:text="@string/create_pin"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/text_14"
                app:backgroundTint="@color/primary"
                app:cornerRadius="@dimen/corner_radius_8"
                app:elevation="@dimen/corner_elevation_8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemovePin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:visibility="gone"
                android:layout_marginTop="@dimen/margin_4"
                android:fontFamily="@font/exo2_semibold"
                android:letterSpacing="0.01"
                android:text="@string/remove_pin"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/text_14"
                app:backgroundTint="@color/bright_red"
                app:cornerRadius="@dimen/corner_radius_8"
                app:elevation="@dimen/corner_elevation_8" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>