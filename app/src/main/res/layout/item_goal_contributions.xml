<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/padding_4">

    <!-- Contribution icon -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivContributionIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_circle_theme"
        android:padding="@dimen/padding_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Contribution type -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvContributionType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_10"
        android:fontFamily="@font/exo2_semibold"
        android:textColor="@color/black"
        android:textSize="@dimen/text_14"
        app:layout_constraintEnd_toStartOf="@id/tvContributionAmount"
        app:layout_constraintStart_toEndOf="@id/ivContributionIcon"
        app:layout_constraintTop_toTopOf="@id/ivContributionIcon" />

    <!-- Date -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvContributionDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_2"
        android:fontFamily="@font/exo2_medium"
        android:textColor="@color/text_grey"
        android:textSize="@dimen/text_12"
        app:layout_constraintBottom_toBottomOf="@+id/ivContributionIcon"
        app:layout_constraintEnd_toStartOf="@id/tvContributionAmount"
        app:layout_constraintStart_toStartOf="@id/tvContributionType"
        app:layout_constraintTop_toBottomOf="@id/tvContributionType" />

    <!-- Amount -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvContributionAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_10"
        android:fontFamily="@font/exo2_semibold"
        android:gravity="end"
        android:textSize="@dimen/text_14"
        app:layout_constraintBottom_toBottomOf="@id/ivContributionIcon"
        app:layout_constraintEnd_toStartOf="@id/ivNavigation"
        app:layout_constraintTop_toTopOf="@id/ivContributionIcon" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivNavigation"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="@dimen/margin_4"
        android:src="@drawable/ic_right_arrow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/vibrant_orange" />

    <!-- Custom Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/margin_4"
        android:layout_marginTop="@dimen/margin_8"
        android:background="@color/light_grey"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvContributionDate"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>