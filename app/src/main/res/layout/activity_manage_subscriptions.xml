<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_light_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/vibrant_orange"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include layout="@layout/toolbar_back" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarWrapper">

        <LinearLayout
            android:id="@+id/topWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_6"
            android:orientation="vertical"
            android:paddingBottom="@dimen/padding_10">

            <!-- SUMMARY -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSubscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_6"
                android:layout_marginBottom="@dimen/margin_6"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_radius_8"
                app:cardElevation="@dimen/corner_elevation_2"
                app:strokeColor="@color/light_lavender"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_premium_card_gradient"
                    android:paddingVertical="@dimen/padding_4">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivPremium"
                        android:layout_width="80dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="@dimen/margin_10"
                        android:layout_marginTop="@dimen/margin_12"
                        android:contentDescription="@null"
                        android:padding="@dimen/padding_6"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_premium_gold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="140dp"
                        android:layout_height="120dp"
                        android:contentDescription="@null"
                        android:scaleType="fitXY"
                        android:src="@drawable/bg_premium_corner"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="@id/ivPremium"
                        app:layout_constraintStart_toEndOf="@id/ivPremium"
                        app:layout_constraintTop_toTopOf="@id/ivPremium">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvUpgradeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_6"
                            android:layout_marginTop="@dimen/margin_2"
                            android:fontFamily="@font/exo2_bold"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_16" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvBadgeActive"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_marginStart="@dimen/margin_6"
                            android:layout_marginTop="@dimen/margin_6"
                            android:background="@drawable/bg_badge_income"
                            android:drawablePadding="@dimen/padding_2"
                            android:drawableTint="@color/dark_income"
                            android:gravity="center"
                            android:paddingStart="@dimen/padding_6"
                            android:paddingEnd="@dimen/padding_6"
                            android:text="@string/active"
                            android:textAllCaps="true"
                            android:textSize="@dimen/text_10"
                            app:fontFamily="@font/exo2_semibold" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvPremiumDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_10"
                        android:layout_marginTop="@dimen/margin_2"
                        android:fontFamily="@font/exo2_medium"
                        android:text="@string/enjoying_premium_features"
                        android:textColor="@color/text_grey"
                        android:textSize="@dimen/text_12"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/ivPremium" />

                    <View
                        android:id="@+id/viewLine"
                        android:layout_width="0dp"
                        android:layout_height="0.8dp"
                        android:layout_marginHorizontal="@dimen/margin_10"
                        android:layout_marginTop="@dimen/margin_10"
                        android:background="@color/grey_88"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvPremiumDesc" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_6"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/viewLine">

                        <!-- ================================================= -->
                        <!-- Plan                                              -->
                        <!-- ================================================= -->
                        <LinearLayout
                            android:id="@+id/layoutPlan"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/edit_text_height_48"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/padding_10">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:padding="@dimen/padding_8"
                                android:src="@drawable/ic_calendar_days"
                                android:tint="@color/primary_dark" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_6"
                                android:layout_weight="0.35"
                                android:fontFamily="@font/exo2_medium"
                                android:text="@string/plan"
                                android:textColor="@color/color_matte_black"
                                android:textSize="@dimen/text_14" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvPlan"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.65"
                                android:fontFamily="@font/exo2_semibold"
                                android:gravity="end|center_vertical"
                                android:textColor="@color/color_matte_black"
                                android:textSize="@dimen/text_14" />
                        </LinearLayout>

                        <!-- ================================================= -->
                        <!-- Price                                             -->
                        <!-- ================================================= -->
                        <LinearLayout
                            android:id="@+id/layoutPrice"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/edit_text_height_48"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/padding_10">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:padding="@dimen/padding_8"
                                android:rotation="90"
                                android:src="@drawable/ic_category_outline"
                                android:tint="@color/primary_dark" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_6"
                                android:layout_weight="0.35"
                                android:fontFamily="@font/exo2_medium"
                                android:text="@string/text_price"
                                android:textColor="@color/color_matte_black"
                                android:textSize="@dimen/text_14" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvPrice"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.65"
                                android:fontFamily="@font/exo2_semibold"
                                android:gravity="end|center_vertical"
                                android:textColor="@color/color_matte_black"
                                android:textSize="@dimen/text_14" />
                        </LinearLayout>

                        <!-- ================================================= -->
                        <!-- Start date                                        -->
                        <!-- ================================================= -->
                        <LinearLayout
                            android:id="@+id/layoutStartDate"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/edit_text_height_48"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/padding_10">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:padding="@dimen/padding_8"
                                android:src="@drawable/ic_calendar"
                                android:tint="@color/primary_dark" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_6"
                                android:layout_weight="0.35"
                                android:fontFamily="@font/exo2_medium"
                                android:text="@string/start_date"
                                android:textColor="@color/color_matte_black"
                                android:textSize="@dimen/text_14" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvStartDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.65"
                                android:fontFamily="@font/exo2_semibold"
                                android:gravity="end|center_vertical"
                                android:textColor="@color/color_matte_black"
                                android:textSize="@dimen/text_14" />
                        </LinearLayout>

                        <!-- ================================================= -->
                        <!-- Next date                                        -->
                        <!-- ================================================= -->
                        <LinearLayout
                            android:id="@+id/layoutNextDate"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/edit_text_height_48"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/padding_10">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:padding="@dimen/padding_8"
                                android:src="@drawable/ic_calendar_empty"
                                android:tint="@color/primary_dark" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_6"
                                android:layout_weight="0.35"
                                android:fontFamily="@font/exo2_medium"
                                android:text="@string/renewal_date"
                                android:textColor="@color/color_matte_black"
                                android:textSize="@dimen/text_14" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvRenewalDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.65"
                                android:fontFamily="@font/exo2_semibold"
                                android:gravity="end|center_vertical"
                                android:textColor="@color/color_matte_black"
                                android:textSize="@dimen/text_14" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BENEFITS -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_6"
                android:layout_marginEnd="@dimen/margin_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivPremiumIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_premium"
                    app:tint="@color/color_gold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_10"
                    android:orientation="vertical"
                    app:layout_constraintStart_toEndOf="@+id/ivPremiumIcon"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/premium_benefits"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_14"
                        app:fontFamily="@font/exo2_semibold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/lblUnlockPremium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dark_grey"
                        android:textSize="@dimen/text_10"
                        app:fontFamily="@font/exo2_medium" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPremiumBenefits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_6"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_radius_8"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPremiumBenefits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="@dimen/padding_6"
                    android:paddingVertical="@dimen/padding_6"
                    tools:listitem="@layout/item_subscription_benefit" />
            </com.google.android.material.card.MaterialCardView>

            <!-- RESTORE PURCHASES -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRestorePurchases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_6"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_radius_8"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/padding_16"
                    android:paddingVertical="@dimen/padding_10">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_box_white"
                        android:backgroundTint="@color/rate_light"
                        android:padding="@dimen/padding_10"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/rate_dark" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/restore_purchases"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_14"
                            app:fontFamily="@font/exo2_semibold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/restore_pro_subscription"
                            android:textColor="@color/text_grey"
                            android:textSize="@dimen/text_12"
                            app:fontFamily="@font/exo2_medium" />

                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_right_arrow_small"
                        app:tint="@color/text_primary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CHANGE PLAN -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_16"
                android:layout_marginEnd="@dimen/margin_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/change_plan"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_14"
                        app:fontFamily="@font/exo2_semibold" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChangePlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_6"
                android:layout_marginBottom="@dimen/margin_10"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_radius_8"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/padding_16"
                    android:paddingVertical="@dimen/padding_10">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_box_white"
                        android:backgroundTint="@color/overspent_bg"
                        android:padding="@dimen/padding_10"
                        android:src="@drawable/ic_change_plan"
                        android:tint="@color/primary_dark"
                        app:tint="@color/overspent_dark" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/switch_plan"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_14"
                            app:fontFamily="@font/exo2_semibold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/upgrade_downgrade_subscription"
                            android:textColor="@color/text_grey"
                            android:textSize="@dimen/text_12"
                            app:fontFamily="@font/exo2_medium" />
                    </LinearLayout>

                    <!-- Right Arrow -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivPlanNavigation"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="@dimen/margin_6"
                        android:src="@drawable/ic_right_arrow_small"
                        app:tint="@color/text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PAYMENT METHOD -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_6"
                android:layout_marginEnd="@dimen/margin_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_payment"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_14"
                        app:fontFamily="@font/exo2_semibold" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_6"
                android:layout_marginBottom="@dimen/margin_10"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_radius_8"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/padding_16"
                    android:paddingVertical="@dimen/padding_10">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_box_white"
                        android:backgroundTint="@color/backup_light"
                        android:padding="@dimen/padding_10"
                        android:src="@drawable/ic_payment_card"
                        app:tint="@color/backup_dark" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_method"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_14"
                            app:fontFamily="@font/exo2_semibold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/update_payment_method"
                            android:textColor="@color/text_grey"
                            android:textSize="@dimen/text_12"
                            app:fontFamily="@font/exo2_medium" />
                    </LinearLayout>

                    <!-- Right Arrow -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivPaymentNavigation"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="@dimen/margin_6"
                        android:src="@drawable/ic_right_arrow_small"
                        app:tint="@color/text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Subscription Support -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_6"
                android:layout_marginEnd="@dimen/margin_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subscription_support"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_14"
                        app:fontFamily="@font/exo2_semibold" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_6"
                android:layout_marginBottom="@dimen/margin_10"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_radius_8"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/padding_16"
                    android:paddingVertical="@dimen/padding_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_box_white"
                            android:backgroundTint="@color/currency_light"
                            android:padding="@dimen/padding_8"
                            android:src="@drawable/ic_support_help"
                            app:tint="@color/currency_dark" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin_10"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/help_center"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_14"
                                app:fontFamily="@font/exo2_semibold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/get_help_subscription"
                                android:textColor="@color/text_grey"
                                android:textSize="@dimen/text_12"
                                app:fontFamily="@font/exo2_medium" />
                        </LinearLayout>

                        <!-- Right Arrow -->
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivHelpNavigation"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="@dimen/margin_6"
                            android:src="@drawable/ic_right_arrow_small"
                            app:tint="@color/text_primary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/margin_12"
                        android:layout_marginStart="@dimen/margin_40"
                        android:background="@color/view_grey" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_box_white"
                            android:backgroundTint="@color/startup_light"
                            android:padding="@dimen/padding_8"
                            android:src="@drawable/ic_contact_support"
                            app:tint="@color/startup_dark" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin_10"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/contact_support"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_14"
                                app:fontFamily="@font/exo2_semibold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/need_more_help_contact"
                                android:textColor="@color/text_grey"
                                android:textSize="@dimen/text_12"
                                app:fontFamily="@font/exo2_medium" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivSupportNavigation"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="@dimen/margin_6"
                            android:src="@drawable/ic_right_arrow_small"
                            app:tint="@color/text_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <include
                android:id="@+id/cardCancelSubscription"
                layout="@layout/layout_subscription_cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_6"
                android:layout_marginBottom="@dimen/margin_10" />

            <include
                android:id="@+id/cardManagePlay"
                layout="@layout/layout_subscription_manage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/edit_text_height_48"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_6" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_40"
                android:layout_marginTop="@dimen/margin_8"
                android:gravity="center_horizontal"
                android:text="@string/manage_subscription_desc"
                android:textColor="@color/text_grey"
                android:textSize="@dimen/text_10"
                app:fontFamily="@font/exo2_medium" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>