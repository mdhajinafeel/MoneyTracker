<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_8">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNoOfInstallments"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/no_of_installments"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusBottomStart="@dimen/corner_radius_4"
        app:boxCornerRadiusTopEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusTopStart="@dimen/corner_radius_4"
        app:boxStrokeColor="@color/vibrant_orange"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1dp"
        app:hintTextColor="@color/vibrant_orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNoOfInstallments"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_56"
            android:drawablePadding="@dimen/padding_4"
            android:focusable="false"
            android:fontFamily="@font/exo2_medium"
            android:gravity="center_vertical"
            android:imeOptions="actionDone"
            android:inputType="none"
            android:longClickable="false"
            android:paddingStart="@dimen/padding_10"
            android:paddingEnd="@dimen/padding_10"
            android:textColor="@color/black"
            android:textSize="@dimen/text_16" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPaymentFrequency"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_10"
        android:hint="@string/frequency"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusBottomStart="@dimen/corner_radius_4"
        app:boxCornerRadiusTopEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusTopStart="@dimen/corner_radius_4"
        app:boxStrokeColor="@color/vibrant_orange"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1dp"
        app:hintTextColor="@color/vibrant_orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tilNoOfInstallments">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPaymentFrequency"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_56"
            android:drawablePadding="@dimen/padding_4"
            android:focusable="false"
            android:fontFamily="@font/exo2_medium"
            android:gravity="center_vertical"
            android:imeOptions="actionDone"
            android:inputType="none"
            android:longClickable="false"
            android:paddingStart="@dimen/padding_10"
            android:paddingEnd="@dimen/padding_10"
            android:textColor="@color/black"
            android:textSize="@dimen/text_16" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilInstallmentAmount"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_10"
        android:hint="@string/installment_amount"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusBottomStart="@dimen/corner_radius_4"
        app:boxCornerRadiusTopEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusTopStart="@dimen/corner_radius_4"
        app:boxStrokeColor="@color/vibrant_orange"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1dp"
        app:hintTextColor="@color/vibrant_orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tilPaymentFrequency">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etInstallmentAmount"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_56"
            android:drawablePadding="@dimen/padding_4"
            android:focusable="false"
            android:fontFamily="@font/exo2_medium"
            android:gravity="center_vertical"
            android:imeOptions="actionDone"
            android:inputType="none"
            android:longClickable="false"
            android:paddingStart="@dimen/padding_10"
            android:paddingEnd="@dimen/padding_10"
            android:textColor="@color/black"
            android:textSize="@dimen/text_16" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilFirstPaymentDate"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_10"
        android:hint="@string/first_payment_date"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusBottomStart="@dimen/corner_radius_4"
        app:boxCornerRadiusTopEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusTopStart="@dimen/corner_radius_4"
        app:boxStrokeColor="@color/vibrant_orange"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1dp"
        app:hintTextColor="@color/vibrant_orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tilInstallmentAmount">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFirstPaymentDate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_56"
            android:drawablePadding="@dimen/padding_4"
            android:focusable="false"
            android:fontFamily="@font/exo2_medium"
            android:gravity="center_vertical"
            android:imeOptions="actionDone"
            android:inputType="none"
            android:longClickable="false"
            android:paddingStart="@dimen/padding_10"
            android:paddingEnd="@dimen/padding_10"
            android:textColor="@color/black"
            android:textSize="@dimen/text_16" />
    </com.google.android.material.textfield.TextInputLayout>
</androidx.constraintlayout.widget.ConstraintLayout>