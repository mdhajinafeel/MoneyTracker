<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_8">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilInterestRate"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/interest_rate"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusBottomStart="@dimen/corner_radius_4"
        app:boxCornerRadiusTopEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusTopStart="@dimen/corner_radius_4"
        app:boxStrokeColor="@color/vibrant_orange"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1dp"
        app:hintTextColor="@color/vibrant_orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etInterestRate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_56"
            android:drawablePadding="@dimen/padding_4"
            android:fontFamily="@font/exo2_medium"
            android:gravity="center_vertical"
            android:imeOptions="actionDone"
            android:inputType="numberDecimal"
            android:paddingStart="@dimen/padding_10"
            android:paddingEnd="@dimen/padding_10"
            android:textColor="@color/black"
            android:textSize="@dimen/text_16" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilInterestPeriod"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_10"
        android:hint="@string/interest_period"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusBottomStart="@dimen/corner_radius_4"
        app:boxCornerRadiusTopEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusTopStart="@dimen/corner_radius_4"
        app:boxStrokeColor="@color/vibrant_orange"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1dp"
        app:hintTextColor="@color/vibrant_orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tilInterestRate">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etInterestPeriod"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_56"
            android:drawablePadding="@dimen/padding_4"
            android:focusable="false"
            android:fontFamily="@font/exo2_medium"
            android:gravity="center_vertical"
            android:inputType="none"
            android:longClickable="false"
            android:paddingStart="@dimen/padding_10"
            android:paddingEnd="@dimen/padding_10"
            android:textColor="@color/black"
            android:textSize="@dimen/text_16" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilInterestAmount"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_10"
        android:hint="@string/interest_amount"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusBottomStart="@dimen/corner_radius_4"
        app:boxCornerRadiusTopEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusTopStart="@dimen/corner_radius_4"
        app:boxStrokeColor="@color/vibrant_orange"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1dp"
        app:hintTextColor="@color/vibrant_orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tilInterestPeriod">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etInterestAmount"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_56"
            android:drawablePadding="@dimen/padding_4"
            android:focusable="false"
            android:fontFamily="@font/exo2_medium"
            android:gravity="center_vertical"
            android:imeOptions="actionDone"
            android:inputType="none"
            android:longClickable="false"
            android:paddingStart="@dimen/padding_10"
            android:paddingEnd="@dimen/padding_10"
            android:textColor="@color/black"
            android:textSize="@dimen/text_16" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCalculationMethod"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_10"
        android:hint="@string/calculation_method"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusBottomStart="@dimen/corner_radius_4"
        app:boxCornerRadiusTopEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusTopStart="@dimen/corner_radius_4"
        app:boxStrokeColor="@color/vibrant_orange"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1dp"
        app:hintTextColor="@color/vibrant_orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tilInterestAmount">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCalculationMethod"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_56"
            android:drawablePadding="@dimen/padding_4"
            android:focusable="false"
            android:fontFamily="@font/exo2_medium"
            android:gravity="center_vertical"
            android:inputType="none"
            android:longClickable="false"
            android:paddingStart="@dimen/padding_10"
            android:paddingEnd="@dimen/padding_10"
            android:textColor="@color/black"
            android:textSize="@dimen/text_16" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCompoundFrequency"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_10"
        android:hint="@string/compound_frequency"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusBottomStart="@dimen/corner_radius_4"
        app:boxCornerRadiusTopEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusTopStart="@dimen/corner_radius_4"
        app:boxStrokeColor="@color/vibrant_orange"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1dp"
        app:hintTextColor="@color/vibrant_orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tilCalculationMethod">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCompoundFrequency"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_56"
            android:drawablePadding="@dimen/padding_4"
            android:focusable="false"
            android:fontFamily="@font/exo2_medium"
            android:gravity="center_vertical"
            android:inputType="none"
            android:longClickable="false"
            android:paddingStart="@dimen/padding_10"
            android:paddingEnd="@dimen/padding_10"
            android:textColor="@color/black"
            android:textSize="@dimen/text_16" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilInterestDuration"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_10"
        android:hint="@string/interest_duration"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusBottomStart="@dimen/corner_radius_4"
        app:boxCornerRadiusTopEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusTopStart="@dimen/corner_radius_4"
        app:boxStrokeColor="@color/vibrant_orange"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1dp"
        app:hintTextColor="@color/vibrant_orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tilCompoundFrequency">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etInterestDuration"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_56"
            android:drawablePadding="@dimen/padding_4"
            android:focusable="false"
            android:fontFamily="@font/exo2_medium"
            android:gravity="center_vertical"
            android:inputType="none"
            android:longClickable="false"
            android:paddingStart="@dimen/padding_10"
            android:paddingEnd="@dimen/padding_10"
            android:textColor="@color/black"
            android:textSize="@dimen/text_16" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCustomInterestDuration"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_10"
        android:hint="@string/duration"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusBottomStart="@dimen/corner_radius_4"
        app:boxCornerRadiusTopEnd="@dimen/corner_radius_4"
        app:boxCornerRadiusTopStart="@dimen/corner_radius_4"
        app:boxStrokeColor="@color/vibrant_orange"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1dp"
        app:hintTextColor="@color/vibrant_orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilInterestDuration">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCustomInterestDuration"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_56"
            android:drawablePadding="@dimen/padding_4"
            android:focusable="false"
            android:fontFamily="@font/exo2_medium"
            android:gravity="center_vertical"
            android:inputType="none"
            android:longClickable="false"
            android:paddingStart="@dimen/padding_10"
            android:paddingEnd="@dimen/padding_10"
            android:textColor="@color/black"
            android:textSize="@dimen/text_16" />

    </com.google.android.material.textfield.TextInputLayout>
</androidx.constraintlayout.widget.ConstraintLayout>