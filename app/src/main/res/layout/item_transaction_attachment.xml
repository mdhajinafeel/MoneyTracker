<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="106dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/margin_8"
    android:layout_marginBottom="@dimen/margin_12"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Preview card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAttachmentPreview"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="@dimen/margin_4"
        app:cardBackgroundColor="@color/very_light_lavender"
        app:cardCornerRadius="@dimen/corner_radius_6"
        app:cardElevation="0dp"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/grey_88"
        app:strokeWidth="1dp">

        <!-- Image preview -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivAttachmentPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_backup_history_img"
            android:visibility="gone" />

        <!-- PDF / DOC / XLS / ZIP etc. -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivAttachmentFileType"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="fitCenter"
            android:layout_gravity="center"
            android:visibility="gone" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Delete button -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDelete"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:visibility="gone"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-6dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/corner_radius_12"
        app:cardElevation="@dimen/corner_elevation_2"
        app:layout_constraintEnd_toEndOf="@id/cardAttachmentPreview"
        app:layout_constraintTop_toTopOf="@id/cardAttachmentPreview"
        app:strokeColor="@color/grey_88"
        app:strokeWidth="1dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgDelete"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:padding="@dimen/padding_4"
            android:src="@drawable/ic_close"
            app:tint="@color/dark_grey" />
    </com.google.android.material.card.MaterialCardView>

    <!-- File name -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvAttachmentName"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_4"
        android:ellipsize="marquee"
        android:focusable="true"
        android:contentDescription="@string/app_name"
        android:focusableInTouchMode="true"
        android:fontFamily="@font/exo2_semibold"
        android:marqueeRepeatLimit="marquee_forever"
        android:maxLines="1"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:textColor="@color/color_matte_black"
        android:textSize="@dimen/text_12"
        app:layout_constraintStart_toStartOf="@id/cardAttachmentPreview"
        app:layout_constraintTop_toBottomOf="@id/cardAttachmentPreview" />

    <!-- File size -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvAttachmentSize"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_2"
        android:ellipsize="end"
        android:fontFamily="@font/exo2_regular"
        android:maxLines="1"
        android:textColor="@color/dark_grey"
        android:textSize="@dimen/text_10"
        app:layout_constraintStart_toStartOf="@id/cardAttachmentPreview"
        app:layout_constraintTop_toBottomOf="@id/tvAttachmentName"/>

    <!-- ADD MORE -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/addMoreContainer"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="@dimen/margin_4"
        android:background="@drawable/bg_dotted_border_color"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivAddMore"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_add"
            app:layout_constraintBottom_toTopOf="@id/tvAddMore"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:tint="@color/primary_dark" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAddMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4"
            android:text="@string/add_more"
            android:textColor="@color/primary_dark"
            android:textSize="@dimen/text_12"
            app:fontFamily="@font/exo2_semibold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivAddMore" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>