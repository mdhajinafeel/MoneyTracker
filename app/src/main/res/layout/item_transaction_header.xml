<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:clipToPadding="false"
    android:layout_marginTop="@dimen/margin_6"
    android:layout_marginBottom="@dimen/margin_8"
    app:strokeColor="@color/card_shadow"
    app:strokeWidth="0.4dp"
    android:layout_marginHorizontal="@dimen/margin_16"
    app:cardUseCompatPadding="false"
    app:cardCornerRadius="@dimen/corner_radius_10"
    app:cardElevation="@dimen/corner_elevation_4">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/padding_12"
        android:paddingEnd="@dimen/padding_12"
        android:paddingTop="@dimen/padding_6"
        android:paddingBottom="@dimen/padding_6">

        <!-- Date -->
        <LinearLayout
            android:id="@+id/llDate"
            android:layout_width="60dp"
            android:layout_height="70dp"
            android:background="@drawable/bg_box_purple"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/padding_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_dark"
                android:textSize="@dimen/text_20"
                app:fontFamily="@font/exo2_bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dark_grey"
                android:textSize="@dimen/text_10"
                app:fontFamily="@font/exo2_medium" />

        </LinearLayout>

        <!-- Right Side -->
        <RelativeLayout
            android:id="@+id/layoutContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_10"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/llDate"
            app:layout_constraintTop_toTopOf="@id/llDate"
            app:layout_constraintBottom_toBottomOf="@+id/llDate"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_18"
                    app:fontFamily="@font/exo2_semibold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvAmount"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTransactionCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_2"
                    android:textColor="@color/funky_grey"
                    android:textSize="@dimen/text_14"
                    app:fontFamily="@font/exo2_medium"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvDay"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvBadgeFuture"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:visibility="gone"
                    android:background="@drawable/bg_badge_future"
                    android:layout_marginStart="@dimen/margin_4"
                    android:gravity="center"
                    android:paddingStart="@dimen/padding_6"
                    android:paddingEnd="@dimen/padding_6"
                    android:textSize="@dimen/text_10"
                    app:fontFamily="@font/exo2_semibold"
                    app:layout_constraintStart_toEndOf="@id/tvTransactionCount"
                    app:layout_constraintTop_toTopOf="@id/tvTransactionCount"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_12"
                    android:textColor="@color/expense"
                    android:textSize="@dimen/text_18"
                    app:fontFamily="@font/exo2_bold"
                    app:layout_constraintEnd_toStartOf="@id/ivCollapse"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivCollapse"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:rotation="180"
                    android:src="@drawable/ic_account_caret"
                    android:tint="@color/primary_dark"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Divider -->
            <View
                android:id="@+id/divider"
                android:layout_below="@+id/layoutHeader"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_12"
                android:background="@color/view_grey" />
        </RelativeLayout>

        <!-- Transactions -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDetailedTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_8"
            android:clipToPadding="false"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llDate"
            android:nestedScrollingEnabled="false" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>