<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/very_light_expense"
    app:cardCornerRadius="@dimen/corner_radius_6"
    app:cardElevation="0dp"
    app:strokeColor="@color/bright_red"
    app:strokeWidth="0.6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/padding_16"
        android:paddingVertical="@dimen/padding_10">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_box_white"
            android:backgroundTint="@color/dim_expense"
            android:padding="@dimen/padding_8"
            android:rotation="90"
            android:src="@drawable/ic_block"
            app:tint="@color/expense" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_10"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel_subscription"
                android:textColor="@color/black"
                android:textSize="@dimen/text_14"
                app:fontFamily="@font/exo2_semibold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel_subscription_desc"
                android:textColor="@color/text_grey"
                android:textSize="@dimen/text_12"
                app:fontFamily="@font/exo2_medium" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivCancelNavigation"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="@dimen/margin_6"
            android:src="@drawable/ic_right_arrow_small"
            app:tint="@color/text_primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>