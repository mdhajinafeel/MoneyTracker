<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_light_background">

    <!-- Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/vibrant_orange"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar_back" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarWrapper">

        <LinearLayout
            android:id="@+id/topWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_6"
            android:orientation="vertical"
            android:paddingStart="@dimen/padding_18"
            android:paddingTop="@dimen/padding_12"
            android:paddingEnd="@dimen/padding_18"
            android:paddingBottom="@dimen/padding_18">

            <!-- Header illustration -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivPasswordHeader"
                android:layout_width="180dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_setting_create_password" />

            <!-- Main heading -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCreatePasswordHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_4"
                android:gravity="center"
                android:text="@string/create_your_password"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_18"
                app:fontFamily="@font/exo2_bold" />

            <!-- Subtitle -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/lblCreatePasswordHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_12"
                android:layout_marginTop="@dimen/margin_8"
                android:layout_marginBottom="@dimen/margin_10"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/primary_light"
                android:textSize="@dimen/text_12"
                app:fontFamily="@font/exo2_medium" />

            <!-- Current Password label -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/lblCurrentPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10"
                android:text="@string/current_password"
                android:textColor="@color/primary_dark"
                android:visibility="gone"
                android:textSize="@dimen/text_14"
                app:fontFamily="@font/exo2_semibold" />

            <!-- Current Password input -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCurrentPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/edit_text_height_56"
                android:layout_marginTop="@dimen/margin_8"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_radius_12"
                app:cardElevation="0dp"
                app:strokeColor="@color/light_lavender"
                app:strokeWidth="0.8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_lock_key"
                        app:tint="@color/primary_light" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etCurrentPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/margin_12"
                        android:layout_marginEnd="@dimen/margin_12"
                        android:layout_weight="1"
                        android:autofillHints="newPassword"
                        android:background="@null"
                        android:fontFamily="@font/exo2_semibold"
                        android:hint="@string/enter_current_password"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="yes"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:padding="0dp"
                        android:textColor="@color/primary"
                        android:textColorHint="@color/text_primary_dark"
                        android:textSize="@dimen/text_16" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivCurrentPasswordVisible"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_eye_off"
                        app:tint="@color/primary_light" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Password label -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/lblPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10"
                android:text="@string/password"
                android:textColor="@color/primary_dark"
                android:textSize="@dimen/text_14"
                app:fontFamily="@font/exo2_semibold" />

            <!-- Password input -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/edit_text_height_56"
                android:layout_marginTop="@dimen/margin_8"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_radius_12"
                app:cardElevation="0dp"
                app:strokeColor="@color/light_lavender"
                app:strokeWidth="0.8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_lock_key"
                        app:tint="@color/primary_light" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/margin_12"
                        android:layout_marginEnd="@dimen/margin_12"
                        android:layout_weight="1"
                        android:autofillHints="newPassword"
                        android:background="@null"
                        android:fontFamily="@font/exo2_semibold"
                        android:hint="@string/enter_your_password"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="yes"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:padding="0dp"
                        android:textColor="@color/primary"
                        android:textColorHint="@color/text_primary_dark"
                        android:textSize="@dimen/text_16" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivPasswordVisible"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_eye_off"
                        app:tint="@color/primary_light" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Confirm password label -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/lblConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10"
                android:text="@string/confirm_password"
                android:textColor="@color/primary_dark"
                android:textSize="@dimen/text_14"
                app:fontFamily="@font/exo2_semibold" />

            <!-- Confirm password input -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/edit_text_height_56"
                android:layout_marginTop="@dimen/margin_8"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_radius_12"
                app:cardElevation="0dp"
                app:strokeColor="@color/light_lavender"
                app:strokeWidth="0.8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_lock_key"
                        app:tint="@color/primary_light" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/margin_12"
                        android:layout_marginEnd="@dimen/margin_12"
                        android:layout_weight="1"
                        android:autofillHints="newPassword"
                        android:background="@null"
                        android:fontFamily="@font/exo2_semibold"
                        android:hint="@string/re_enter_your_password"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="yes"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:padding="0dp"
                        android:textColor="@color/primary"
                        android:textColorHint="@color/text_primary_dark"
                        android:textSize="@dimen/text_16" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivConfirmPasswordVisible"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_eye_off"
                        app:tint="@color/primary_light" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Password requirements card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPasswordRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20"
                app:cardBackgroundColor="@color/app_light_background"
                app:cardCornerRadius="@dimen/corner_radius_16"
                app:cardElevation="0dp"
                app:strokeColor="@color/primary_light"
                app:strokeWidth="0.4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_18">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/password_requirements"
                        android:textColor="@color/primary_dark"
                        android:textSize="@dimen/text_16"
                        app:fontFamily="@font/exo2_bold" />

                    <!-- Requirement 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivRequirementLength"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_complete"
                            app:tint="@color/primary_dark" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvRequirementLength"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_6"
                            android:layout_weight="1"
                            android:text="@string/minimum_8_characters"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_12"
                            app:fontFamily="@font/exo2_medium" />
                    </LinearLayout>

                    <!-- Requirement 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivRequirementLetter"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_complete"
                            app:tint="@color/primary_dark" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvRequirementLetter"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_6"
                            android:layout_weight="1"
                            android:text="@string/include_least_letter"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_12"
                            app:fontFamily="@font/exo2_medium" />
                    </LinearLayout>

                    <!-- Requirement 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivRequirementNumber"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_complete"
                            app:tint="@color/primary_dark" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvRequirementNumber"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_6"
                            android:layout_weight="1"
                            android:text="@string/include_least_number"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_12"
                            app:fontFamily="@font/exo2_medium" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreatePassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="@dimen/margin_12"
                android:fontFamily="@font/exo2_semibold"
                android:letterSpacing="0.01"
                android:text="@string/create_password"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/text_14"
                app:backgroundTint="@color/primary"
                app:cornerRadius="@dimen/corner_radius_8"
                app:elevation="@dimen/corner_elevation_8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemovePassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:visibility="gone"
                android:layout_marginTop="@dimen/margin_4"
                android:fontFamily="@font/exo2_semibold"
                android:letterSpacing="0.01"
                android:text="@string/remove_password"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/text_14"
                app:backgroundTint="@color/bright_red"
                app:cornerRadius="@dimen/corner_radius_8"
                app:elevation="@dimen/corner_elevation_8" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>