<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_light_background">

    <!-- Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/vibrant_orange"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar_back" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarWrapper">

        <LinearLayout
            android:id="@+id/topWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_6"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/backupCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_12"
                android:layout_marginEnd="@dimen/margin_16"
                app:cardBackgroundColor="@color/app_light_background"
                app:cardCornerRadius="@dimen/corner_radius_6"
                app:cardElevation="0dp"
                app:strokeColor="@color/primary_light"
                app:strokeWidth="0.4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/padding_8"
                    android:paddingBottom="@dimen/padding_8">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="@+id/ivBackupSetting"
                        app:layout_constraintEnd_toStartOf="@id/ivBackupSetting"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/ivBackupSetting">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/lblTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_10"
                            android:text="@string/keep_data_safe"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_18"
                            app:fontFamily="@font/exo2_bold"
                            app:layout_constraintBottom_toBottomOf="@+id/ivBackupDesc"
                            app:layout_constraintEnd_toStartOf="@+id/ivBackupSetting"
                            app:layout_constraintStart_toEndOf="@+id/ivBackupDesc"
                            app:layout_constraintTop_toTopOf="@+id/ivBackupDesc" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/lblDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_10"
                            android:layout_marginTop="@dimen/margin_6"
                            android:layout_marginEnd="@dimen/margin_6"
                            android:text="@string/setting_data_hint"
                            android:textColor="@color/dark_grey"
                            android:textSize="@dimen/text_12"
                            app:fontFamily="@font/exo2_medium"
                            app:layout_constraintEnd_toStartOf="@+id/ivBackupSetting"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/ivBackupDesc" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivBackupSetting"
                        android:layout_width="100dp"
                        android:layout_height="80dp"
                        android:layout_marginEnd="@dimen/margin_10"
                        android:src="@drawable/ic_password_setting"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/passwordSettingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_12"
                android:layout_marginEnd="@dimen/margin_16"
                android:layout_marginBottom="@dimen/margin_10"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_radius_6"
                app:cardElevation="@dimen/corner_elevation_6"
                app:strokeColor="@color/grey_88"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/margin_10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/appLockContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/margin_16"
                        android:paddingEnd="@dimen/margin_16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivAppLock"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_box_purple"
                            android:padding="@dimen/padding_6"
                            android:src="@drawable/ic_lock_key"
                            app:layout_constraintBottom_toBottomOf="@id/layoutAppLockDetails"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/layoutAppLockDetails"
                            app:tint="@color/primary_dark" />

                        <LinearLayout
                            android:id="@+id/layoutAppLockDetails"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_8"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/switchAppLock"
                            app:layout_constraintStart_toEndOf="@id/ivAppLock"
                            app:layout_constraintTop_toTopOf="parent">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvAppLockTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/app_lock"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_16"
                                app:fontFamily="@font/exo2_semibold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvAppLockDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_2"
                                android:ellipsize="middle"
                                android:maxLines="2"
                                android:text="@string/app_lock_hint"
                                android:textColor="@color/dark_grey"
                                android:textSize="@dimen/text_12"
                                app:fontFamily="@font/exo2_medium" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchAppLock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/app_lock"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:thumbTint="@color/switch_thumb_selector"
                            app:trackTint="@color/switch_track_selector" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:id="@+id/viewLine1"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="@dimen/margin_16"
                        android:layout_marginTop="@dimen/margin_4"
                        android:background="@color/view_grey"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/appLockContainer" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/passwordContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8"
                        android:alpha="0.4"
                        android:clickable="false"
                        android:paddingVertical="@dimen/padding_6"
                        android:paddingStart="@dimen/margin_16"
                        android:paddingEnd="@dimen/margin_16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/viewLine1">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivPassword"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_box_purple"
                            android:padding="@dimen/padding_8"
                            android:src="@drawable/ic_key"
                            app:layout_constraintBottom_toBottomOf="@id/layoutPasswordDetails"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/layoutPasswordDetails"
                            app:tint="@color/primary_dark" />

                        <LinearLayout
                            android:id="@+id/layoutPasswordDetails"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_8"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/ivPasswordNav"
                            app:layout_constraintStart_toEndOf="@id/ivPassword"
                            app:layout_constraintTop_toTopOf="parent">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvPasswordTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/password"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_16"
                                app:fontFamily="@font/exo2_semibold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvPasswordDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_2"
                                android:ellipsize="middle"
                                android:maxLines="2"
                                android:text="@string/not_set"
                                android:textColor="@color/dark_grey"
                                android:textSize="@dimen/text_12"
                                app:fontFamily="@font/exo2_medium" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivPasswordNav"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="@dimen/margin_12"
                            android:src="@drawable/ic_right_arrow"
                            android:tint="@color/primary"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:id="@+id/viewLine2"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="@dimen/margin_16"
                        android:layout_marginTop="@dimen/margin_4"
                        android:background="@color/view_grey"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/passwordContainer" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/pinContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8"
                        android:alpha="0.4"
                        android:clickable="false"
                        android:paddingVertical="@dimen/padding_6"
                        android:paddingStart="@dimen/margin_16"
                        android:paddingEnd="@dimen/margin_16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/viewLine2">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivPin"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_box_purple"
                            android:padding="@dimen/padding_8"
                            android:src="@drawable/ic_pin_dot"
                            app:layout_constraintBottom_toBottomOf="@id/layoutPinDetails"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/layoutPinDetails"
                            app:tint="@color/primary_dark" />

                        <LinearLayout
                            android:id="@+id/layoutPinDetails"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_8"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/ivPinNavigation"
                            app:layout_constraintStart_toEndOf="@id/ivPin"
                            app:layout_constraintTop_toTopOf="parent">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvPinTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_pin"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_16"
                                app:fontFamily="@font/exo2_semibold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvPinDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_2"
                                android:ellipsize="middle"
                                android:maxLines="2"
                                android:text="@string/not_set"
                                android:textColor="@color/dark_grey"
                                android:textSize="@dimen/text_12"
                                app:fontFamily="@font/exo2_medium" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivPinNavigation"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="@dimen/margin_12"
                            android:src="@drawable/ic_right_arrow"
                            android:tint="@color/primary"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:id="@+id/viewLine3"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="@dimen/margin_16"
                        android:layout_marginTop="@dimen/margin_4"
                        android:background="@color/view_grey"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/pinContainer" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/fingerprintContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8"
                        android:alpha="0.4"
                        android:clickable="false"
                        android:paddingVertical="@dimen/padding_6"
                        android:paddingStart="@dimen/margin_16"
                        android:paddingEnd="@dimen/margin_16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/viewLine3">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivFingerprint"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_box_purple"
                            android:padding="@dimen/padding_6"
                            android:src="@drawable/ic_fingerprint"
                            app:layout_constraintBottom_toBottomOf="@id/layoutFingerprintDetails"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/layoutFingerprintDetails"
                            app:tint="@color/primary_dark" />

                        <LinearLayout
                            android:id="@+id/layoutFingerprintDetails"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_8"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/switchFingerprint"
                            app:layout_constraintStart_toEndOf="@id/ivFingerprint"
                            app:layout_constraintTop_toTopOf="parent">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvFingerprintTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/fingerprint"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_16"
                                app:fontFamily="@font/exo2_semibold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvFingerprintDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_2"
                                android:ellipsize="middle"
                                android:maxLines="2"
                                android:text="@string/not_enabled"
                                android:textColor="@color/dark_grey"
                                android:textSize="@dimen/text_12"
                                app:fontFamily="@font/exo2_medium" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchFingerprint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:thumbTint="@color/switch_thumb_selector"
                            app:trackTint="@color/switch_track_selector" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:id="@+id/viewLine4"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="@dimen/margin_16"
                        android:layout_marginTop="@dimen/margin_4"
                        android:background="@color/view_grey"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/fingerprintContainer" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/autoLockContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8"
                        android:alpha="0.4"
                        android:clickable="false"
                        android:paddingVertical="@dimen/padding_6"
                        android:paddingStart="@dimen/margin_16"
                        android:paddingEnd="@dimen/margin_16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/viewLine4">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivAutoLock"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_box_purple"
                            android:padding="@dimen/padding_8"
                            android:src="@drawable/ic_auto_lock"
                            app:layout_constraintBottom_toBottomOf="@id/layoutAutoLockDetails"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/layoutAutoLockDetails"
                            app:tint="@color/primary_dark" />

                        <LinearLayout
                            android:id="@+id/layoutAutoLockDetails"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_8"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/ivAutoLockNav"
                            app:layout_constraintStart_toEndOf="@id/ivAutoLock"
                            app:layout_constraintTop_toTopOf="parent">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvAutoLockTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/auto_lock"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_16"
                                app:fontFamily="@font/exo2_semibold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvAutoLockDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_2"
                                android:ellipsize="middle"
                                android:maxLines="2"
                                android:text="@string/auto_lock_interval"
                                android:textColor="@color/dark_grey"
                                android:textSize="@dimen/text_12"
                                app:fontFamily="@font/exo2_medium" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivAutoLockNav"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="@dimen/margin_12"
                            android:src="@drawable/ic_right_arrow"
                            android:tint="@color/primary"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:id="@+id/viewLine5"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="@dimen/margin_16"
                        android:layout_marginTop="@dimen/margin_4"
                        android:background="@color/view_grey"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/autoLockContainer" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/primaryMethodContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8"
                        android:alpha="0.4"
                        android:clickable="false"
                        android:paddingVertical="@dimen/padding_6"
                        android:paddingStart="@dimen/margin_16"
                        android:paddingEnd="@dimen/margin_16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/viewLine5">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivPrimaryMethod"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_box_purple"
                            android:padding="@dimen/padding_8"
                            android:src="@drawable/ic_privacy"
                            app:layout_constraintBottom_toBottomOf="@id/layoutPrimaryMethodDetails"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/layoutPrimaryMethodDetails"
                            app:tint="@color/primary_dark" />

                        <LinearLayout
                            android:id="@+id/layoutPrimaryMethodDetails"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_8"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/ivPrimaryMethodNav"
                            app:layout_constraintStart_toEndOf="@id/ivPrimaryMethod"
                            app:layout_constraintTop_toTopOf="parent">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvPrimaryMethodTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/primary_unlock_method"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_16"
                                app:fontFamily="@font/exo2_semibold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvPrimaryMethodDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_2"
                                android:ellipsize="middle"
                                android:maxLines="2"
                                android:textColor="@color/dark_grey"
                                android:textSize="@dimen/text_12"
                                app:fontFamily="@font/exo2_medium" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivPrimaryMethodNav"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="@dimen/margin_12"
                            android:src="@drawable/ic_right_arrow"
                            android:tint="@color/primary"
