<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin_16"
    android:layout_marginTop="@dimen/margin_8"
    android:layout_marginEnd="@dimen/margin_16"
    android:layout_marginBottom="@dimen/margin_4"
    android:background="@color/white"
    android:clipToPadding="false"
    app:cardCornerRadius="@dimen/corner_radius_10"
    app:cardElevation="@dimen/corner_elevation_4"
    app:cardUseCompatPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/itemView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_10">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDebtIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="@dimen/margin_4"
            app:cardCornerRadius="@dimen/corner_radius_16"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/progressBudget"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/leftWrapper">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivDebtIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.18" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/leftWrapper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_6"
            android:layout_marginEnd="@dimen/margin_2"
            app:layout_constraintEnd_toStartOf="@id/ivMore"
            app:layout_constraintStart_toEndOf="@id/guideline1"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDebtTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/padding_8"
                android:textColor="@color/black"
                android:textSize="@dimen/text_16"
                app:fontFamily="@font/exo2_semibold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/debtContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_6"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="@id/tvDebtTitle"
                app:layout_constraintTop_toBottomOf="@id/tvDebtTitle">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStartDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/padding_4"
                    android:drawableTint="@color/dark_grey"
                    android:fontFamily="@font/exo2_medium"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:textColor="@color/dark_grey"
                    android:textSize="@dimen/text_12" />

                <View
                    android:id="@+id/viewLine2"
                    android:layout_width="0.4dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="@dimen/margin_4"
                    android:background="@color/grey_88"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDebtLoanStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_4"
                    android:background="@drawable/bg_badge_income"
                    android:drawablePadding="@dimen/padding_4"
                    android:drawableTint="@color/income"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/padding_8"
                    android:paddingVertical="@dimen/padding_2"
                    android:textAllCaps="true"
                    android:textColor="@color/income"
                    android:textSize="@dimen/text_10"
                    android:visibility="gone"
                    app:fontFamily="@font/exo2_semibold" />

            </LinearLayout>

            <!-- Saved Amount -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSavedAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_6"
                android:fontFamily="@font/exo2_bold"
                android:textSize="@dimen/text_16"
                app:layout_constraintStart_toStartOf="@id/tvDebtTitle"
                app:layout_constraintTop_toBottomOf="@id/debtContainer" />

            <!-- Target Amount -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTargetAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_4"
                android:fontFamily="@font/exo2_medium"
                android:textColor="@color/dark_grey"
                android:textSize="@dimen/text_14"
                app:layout_constraintBottom_toBottomOf="@id/tvSavedAmount"
                app:layout_constraintStart_toEndOf="@id/tvSavedAmount"
                app:layout_constraintTop_toTopOf="@id/tvSavedAmount" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBudget"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginTop="@dimen/margin_4"
            android:layout_marginEnd="@dimen/margin_4"
            android:max="100"
            android:progressDrawable="@drawable/progress_goal"
            app:layout_constraintEnd_toStartOf="@+id/tvProgressPercentage"
            app:layout_constraintStart_toStartOf="@id/leftWrapper"
            app:layout_constraintTop_toBottomOf="@id/leftWrapper" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvProgressPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_4"
            android:fontFamily="@font/exo2_semibold"
            android:textColor="@color/dark_grey"
            android:textSize="@dimen/text_14"
            app:layout_constraintBottom_toBottomOf="@id/progressBudget"
            app:layout_constraintEnd_toEndOf="@id/ivMore"
            app:layout_constraintTop_toTopOf="@id/progressBudget" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivMore"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/more"
            android:padding="@dimen/padding_4"
            android:src="@drawable/ic_more_menu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/black" />

        <LinearLayout
            android:id="@+id/bottomContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_8"
            android:layout_marginTop="@dimen/margin_6"
            android:baselineAligned="true"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/padding_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressBudget">

            <!-- LEFT -->
            <LinearLayout
                android:id="@+id/layoutDaysLeft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_calendar_days_left"
                    app:tint="@color/dark_grey" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDaysLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_4"
                    android:fontFamily="@font/exo2_medium"
                    android:textColor="@color/dark_grey"
                    android:textSize="@dimen/text_14" />
            </LinearLayout>

            <!-- RIGHT -->
            <LinearLayout
                android:id="@+id/layoutAlert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivAlertIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_alert_thin"
                    app:tint="@color/dark_grey" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAlert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_4"
                    android:fontFamily="@font/exo2_medium"
                    android:textColor="@color/dark_grey"
                    android:textSize="@dimen/text_14" />

            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>