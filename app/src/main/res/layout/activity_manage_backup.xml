<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_light_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/vibrant_orange"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include layout="@layout/toolbar_back" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarWrapper">

        <LinearLayout
            android:id="@+id/topWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_6"
            android:orientation="vertical"
            android:paddingBottom="@dimen/margin_24">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBackupOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/padding_4" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_marginEnd="@dimen/margin_16"
                android:background="@drawable/bg_box_hint"
                android:paddingVertical="@dimen/padding_10">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivHintIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_theme"
                    android:padding="@dimen/padding_4"
                    android:layout_marginStart="@dimen/margin_10"
                    android:src="@drawable/ic_privacy_outline"
                    android:tint="@color/primary_light"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvHintTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_8"
                    android:text="@string/data_safe"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_16"
                    app:fontFamily="@font/exo2_bold"
                    app:layout_constraintBottom_toTopOf="@id/tvHintTitleDesc"
                    app:layout_constraintEnd_toStartOf="@+id/ivManage"
                    app:layout_constraintStart_toEndOf="@id/ivHintIcon"
                    app:layout_constraintTop_toTopOf="@id/ivHintIcon"
                    app:layout_constraintVertical_chainStyle="packed" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvHintTitleDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_8"
                    android:layout_marginEnd="@dimen/margin_6"
                    android:layout_marginTop="@dimen/margin_4"
                    android:text="@string/data_safe_hint"
                    android:textColor="@color/very_dark_grey"
                    android:textSize="@dimen/text_12"
                    app:fontFamily="@font/exo2_medium"
                    app:layout_constraintBottom_toBottomOf="@id/ivHintIcon"
                    app:layout_constraintEnd_toStartOf="@+id/ivManage"
                    app:layout_constraintStart_toEndOf="@id/ivHintIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvHintTitle" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivManage"
                    android:layout_width="100dp"
                    android:layout_height="80dp"
                    android:scaleType="centerInside"
                    android:layout_marginEnd="@dimen/margin_10"
                    android:src="@drawable/ic_backup_manage"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>