<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/corner_radius_12"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_shadow"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_12">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvRepaymentScheduleTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repayment_schedule"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_14"
            app:fontFamily="@font/exo2_bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSchedulePaymentCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/dark_grey"
                android:textSize="@dimen/text_12"
                app:fontFamily="@font/exo2_medium" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvScheduleFrequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dark_grey"
                android:textSize="@dimen/text_12"
                app:fontFamily="@font/exo2_medium" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_8"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvScheduleTotalLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/total_payment"
                android:textColor="@color/dark_grey"
                android:textSize="@dimen/text_12"
                app:fontFamily="@font/exo2_medium" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvScheduleTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_12"
                app:fontFamily="@font/exo2_semibold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/total_interest"
                android:textColor="@color/dark_grey"
                android:textSize="@dimen/text_12"
                app:fontFamily="@font/exo2_medium" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvScheduleTotalInterest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_12"
                app:fontFamily="@font/exo2_semibold" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRepaymentSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_8"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>