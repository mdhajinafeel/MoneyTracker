<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_4"
    android:layout_marginBottom="@dimen/margin_2">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/transactionDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/padding_8"
        android:textColor="@color/black"
        android:textSize="@dimen/text_16"
        android:visibility="gone"
        app:fontFamily="@font/exo2_medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/colorView"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_circle"
        app:layout_constraintBottom_toBottomOf="@id/labelWrapper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/labelWrapper"
        app:layout_constraintVertical_bias="0.5">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imageView"
            android:layout_width="26dp"
            android:layout_height="26dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/labelWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_6"
        android:layout_marginEnd="@dimen/margin_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/colorView"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/nameLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/padding_8"
            android:textColor="@color/black"
            android:textSize="@dimen/text_20"
            app:fontFamily="@font/exo2_semibold"
            app:layout_constraintEnd_toStartOf="@id/amountLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivMore"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="@dimen/padding_4"
            android:src="@drawable/ic_more_menu"
            app:layout_constraintBottom_toBottomOf="@+id/timeLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/amountLabel" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/amountLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_12"
            android:textColor="@color/black"
            android:textSize="@dimen/text_18"
            app:fontFamily="@font/exo2_bold"
            app:layout_constraintBaseline_toBaselineOf="@id/nameLabel"
            app:layout_constraintEnd_toStartOf="@id/ivMore" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/feeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_6"
            android:layout_marginEnd="@dimen/margin_8"
            android:textColor="@color/black"
            android:textSize="@dimen/text_16"
            android:visibility="gone"
            app:fontFamily="@font/exo2_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nameLabel" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvBadgeFee"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginStart="@dimen/margin_8"
            android:background="@drawable/bg_badge_income"
            android:gravity="center"
            android:paddingStart="@dimen/padding_6"
            android:paddingEnd="@dimen/padding_6"
            android:textSize="@dimen/text_10"
            android:visibility="gone"
            app:fontFamily="@font/exo2_semibold"
            app:layout_constraintBottom_toBottomOf="@id/feeLabel"
            app:layout_constraintStart_toEndOf="@id/feeLabel"
            app:layout_constraintTop_toTopOf="@id/feeLabel" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/feeAmountLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_12"
            android:textColor="@color/black"
            android:textSize="@dimen/text_16"
            android:visibility="gone"
            app:fontFamily="@font/exo2_semibold"
            app:layout_constraintBaseline_toBaselineOf="@id/feeLabel"
            app:layout_constraintEnd_toStartOf="@id/ivMore" />

        <LinearLayout
            android:id="@+id/detailWrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/feeLabel">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/detailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dark_grey"
                android:textSize="@dimen/text_14"
                app:fontFamily="@font/exo2_medium" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBadgeDetail"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginStart="@dimen/margin_8"
                android:gravity="center"
                android:paddingStart="@dimen/padding_6"
                android:paddingEnd="@dimen/padding_6"
                android:textSize="@dimen/text_10"
                app:fontFamily="@font/exo2_semibold" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/timeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_12"
            android:drawablePadding="@dimen/padding_4"
            android:gravity="center_vertical"
            android:textColor="@color/color_matte_black"
            android:textSize="@dimen/text_14"
            app:fontFamily="@font/exo2_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivMore"
            app:layout_constraintTop_toBottomOf="@id/feeAmountLabel" />

        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/margin_6"
            android:background="@color/view_grey"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/timeLabel" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>