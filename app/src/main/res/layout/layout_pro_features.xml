<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:background="@color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Feature name -->

    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/margin_8"
            android:padding="@dimen/padding_2"
            android:scaleType="fitCenter"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvFeatureName"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="@font/exo2_medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="@dimen/padding_8"
            android:paddingEnd="@dimen/padding_10"
            android:textColor="@color/color_matte_black"
            android:textSize="@dimen/text_14" />
    </LinearLayout>

    <!-- Free plan value -->
    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:background="@color/pale_lavendar">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvFreeValue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/exo2_regular"
            android:gravity="center"
            android:maxLines="2"
            android:paddingHorizontal="@dimen/padding_4"
            android:textColor="@color/grayish_purple"
            android:textSize="@dimen/text_14" />
    </FrameLayout>

    <!-- Pro plan icon -->
    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:background="@color/white">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivIconPro"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:padding="@dimen/padding_4"
            android:src="@drawable/ic_complete"
            android:tint="@color/vibrant_orange" />
    </FrameLayout>
</LinearLayout>