<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:clickable="true"
    android:focusable="true"
    android:elevation="20dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="@drawable/bg_auth_dialog">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            app:indicatorSize="48dp"
            app:trackThickness="4dp"
            app:indicatorColor="@color/bright_violet" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLoaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/creating_account"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_14"
            android:fontFamily="@font/exo2_semibold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLoaderDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_6"
            android:text="@string/please_wait"
            android:fontFamily="@font/exo2_medium"
            android:textColor="@color/primary_light"
            android:textSize="@dimen/text_12" />

    </LinearLayout>
</FrameLayout>
