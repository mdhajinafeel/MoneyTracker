<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin_16"
    android:layout_marginTop="@dimen/margin_10"
    android:background="@color/white"
    android:clipToPadding="false"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/corner_radius_10"
    app:cardElevation="@dimen/corner_elevation_4"
    app:cardUseCompatPadding="false"
    app:strokeColor="@color/card_shadow"
    app:strokeWidth="0.4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/padding_12"
        android:paddingTop="@dimen/padding_14"
        android:paddingEnd="@dimen/padding_12"
        android:paddingBottom="@dimen/padding_14">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAccountIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="@dimen/margin_6"
            app:cardCornerRadius="@dimen/corner_radius_16"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivAccountIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/layoutAccountDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_8"
            android:layout_marginTop="@dimen/margin_6"
            android:layout_marginBottom="@dimen/margin_6"
            android:orientation="vertical"
            android:paddingVertical="@dimen/padding_4"
            app:layout_constraintBottom_toBottomOf="@id/cardAccountIcon"
            app:layout_constraintEnd_toStartOf="@+id/tvAccountAmount"
            app:layout_constraintStart_toEndOf="@id/cardAccountIcon"
            app:layout_constraintTop_toTopOf="@id/cardAccountIcon">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAccountName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/padding_2"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_16"
                app:fontFamily="@font/exo2_semibold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAccountCurrency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:focusable="true"
                android:fontFamily="@font/exo2_medium"
                android:focusableInTouchMode="true"
                android:scrollHorizontally="true"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_12" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAccountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_6"
                android:background="@drawable/bg_badge_future"
                android:ellipsize="end"
                android:fontFamily="@font/exo2_medium"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/padding_6"
                android:paddingVertical="@dimen/padding_2"
                android:text="@string/text_default"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_10"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAccountArchiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_6"
                android:background="@drawable/bg_badge_transfer"
                android:drawablePadding="@dimen/padding_2"
                android:ellipsize="end"
                android:fontFamily="@font/exo2_medium"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/padding_6"
                android:paddingVertical="@dimen/padding_2"
                android:textColor="@color/transfer"
                android:textSize="@dimen/text_10"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAccountAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_4"
            android:paddingVertical="@dimen/padding_2"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_18"
            app:fontFamily="@font/exo2_semibold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivMore"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivMore"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="@dimen/padding_4"
            android:src="@drawable/ic_more_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>