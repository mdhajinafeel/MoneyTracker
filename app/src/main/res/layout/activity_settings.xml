<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rootView"
    android:background="@color/app_light_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/vibrant_orange"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include layout="@layout/toolbar_back" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarWrapper">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Upgrade -->
            <RelativeLayout
                android:id="@+id/rlUpgrade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_10"
                android:layout_marginTop="@dimen/margin_4"
                android:layout_marginEnd="@dimen/margin_10">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUpgrade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_8"
                    android:layout_marginTop="@dimen/margin_6"
                    android:layout_marginBottom="@dimen/margin_6"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/corner_radius_8"
                    app:cardElevation="@dimen/corner_elevation_2"
                    app:strokeColor="@color/light_lavender"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Left Gradient -->
                        <FrameLayout
                            android:id="@+id/leftPanel"
                            android:layout_width="90dp"
                            android:layout_height="0dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent">

                            <com.nprotech.moneytracker.utils.CurvedBackgroundView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_upgrade_pro"
                                android:scaleType="fitCenter"/>

                        </FrameLayout>

                        <!-- Diamond -->
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivDiamond"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:scaleType="center"
                            android:src="@drawable/ic_upgrade_pro"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@id/leftPanel"
                            app:layout_constraintStart_toStartOf="@id/leftPanel"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- Premium Chip -->
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvPremium"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginTop="@dimen/margin_6"
                            android:background="@drawable/bg_premium_chip"
                            android:drawableStart="@drawable/ic_premium"
                            android:drawablePadding="@dimen/padding_2"
                            android:drawableTint="@color/primary_dark"
                            android:fontFamily="@font/exo2_semibold"
                            android:gravity="center"
                            android:textAllCaps="true"
                            android:paddingHorizontal="@dimen/padding_6"
                            android:text="@string/premium"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_10"
                            app:layout_constraintStart_toEndOf="@id/leftPanel"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- Price -->
                        <LinearLayout
                            android:id="@+id/layoutPrice"
                            android:layout_width="70dp"
                            android:layout_height="58dp"
                            android:layout_marginTop="@dimen/margin_12"
                            android:layout_marginEnd="@dimen/margin_12"
                            android:background="@drawable/bg_price_box"
                            android:gravity="center"
                            android:orientation="vertical"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/text_20"
                                android:fontFamily="@font/exo2_bold"/>

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/month"
                                android:fontFamily="@font/exo2_medium"
                                android:textColor="@color/text_grey"
                                android:textSize="@dimen/text_12" />

                        </LinearLayout>

                        <!-- Title -->
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_2"
                            android:fontFamily="@font/exo2_bold"
                            android:text="@string/upgrade_to_premium"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_16"
                            app:layout_constraintEnd_toStartOf="@id/layoutPrice"
                            app:layout_constraintStart_toStartOf="@id/tvPremium"
                            app:layout_constraintTop_toBottomOf="@id/tvPremium" />

                        <!-- Subtitle -->
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvSubtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_2"
                            android:text="@string/upgrade_subtext"
                            android:textColor="@color/text_grey"
                            android:fontFamily="@font/exo2_medium"
                            android:textSize="@dimen/text_10"
                            app:layout_constraintEnd_toStartOf="@id/layoutPrice"
                            app:layout_constraintStart_toStartOf="@id/tvTitle"
                            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

                        <!-- Features -->
                        <LinearLayout
                            android:id="@+id/layoutFeatures"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_10"
                            android:orientation="horizontal"
                            android:paddingBottom="@dimen/margin_14"
                            app:layout_constraintStart_toEndOf="@id/leftPanel"
                            app:layout_constraintEnd_toStartOf="@id/btnUpgrade"
                            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

                            <!-- Left -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.7"
                                android:orientation="vertical">

                                <include
                                    android:id="@+id/featureWallet"
                                    layout="@layout/item_feature" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="@dimen/margin_6"
                                android:layout_marginBottom="@dimen/margin_6"
                                android:background="@color/light_lavender" />

                            <!-- Center -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.7"
                                android:orientation="vertical">

                                <include
                                    android:id="@+id/featureCloud"
                                    layout="@layout/item_feature" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="@dimen/margin_6"
                                android:layout_marginBottom="@dimen/margin_6"
                                android:background="@color/light_lavender" />

                            <!-- Right -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.7"
                                android:orientation="vertical">

                                <include
                                    android:id="@+id/featureOthers"
                                    layout="@layout/item_feature" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Upgrade Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUpgrade"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginEnd="12dp"
                            android:text="@string/upgrade"
                            android:textAllCaps="false"
                            android:letterSpacing="0"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/text_12"
                            app:backgroundTint="@color/primary"
                            app:cornerRadius="@dimen/corner_radius_4"
                            android:fontFamily="@font/exo2_medium"
                            app:icon="@drawable/ic_arrow_right"
                            app:iconGravity="textEnd"
                            app:iconPadding="6dp"
                            app:iconSize="12dp"
                            app:layout_constraintTop_toTopOf="@id/layoutFeatures"
                            app:layout_constraintBottom_toBottomOf="@id/layoutFeatures"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>

            <!-- Management -->
            <RelativeLayout
                android:id="@+id/rlManagement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_10"
                android:layout_marginTop="@dimen/margin_4"
                android:layout_marginEnd="@dimen/margin_10">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/managementCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_8"
                    android:layout_marginTop="@dimen/margin_6"
                    android:layout_marginEnd="@dimen/margin_8"
                    android:layout_marginBottom="@dimen/margin_6"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/corner_radius_8"
                    app:cardElevation="@dimen/corner_elevation_2"
                    app:strokeColor="@color/card_shadow"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvManagement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_12"
                            android:layout_marginTop="@dimen/margin_12"
                            android:text="@string/management"
                            android:textAllCaps="true"
                            android:textColor="@color/vibrant_orange"
                            android:textSize="@dimen/text_14"
                            app:drawableTint="@color/vibrant_orange"
                            app:fontFamily="@font/exo2_semibold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvManagement"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_10"
                            android:layout_marginBottom="@dimen/margin_10"
                            android:background="@color/white"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>

            <!-- Configuration -->
            <RelativeLayout
                android:id="@+id/rlConfigurations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_10"
                android:layout_marginTop="@dimen/margin_4"
                android:layout_marginEnd="@dimen/margin_10">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/configCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_8"
                    android:layout_marginTop="@dimen/margin_6"
                    android:layout_marginEnd="@dimen/margin_8"
                    android:layout_marginBottom="@dimen/margin_6"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/corner_radius_8"
                    app:cardElevation="@dimen/corner_elevation_2"
                    app:strokeColor="@color/card_shadow"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvConfiguration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_12"
                            android:layout_marginTop="@dimen/margin_12"
                            android:text="@string/configuration"
                            android:textAllCaps="true"
                            android:textColor="@color/vibrant_orange"
                            android:textSize="@dimen/text_14"
                            app:drawableTint="@color/vibrant_orange"
                            app:fontFamily="@font/exo2_semibold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvConfigurations"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_10"
                            android:layout_marginBottom="@dimen/margin_10"
                            android:background="@color/white"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>

            <!-- Backup -->
            <RelativeLayout
                android:id="@+id/rlBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_10"
                android:layout_marginTop="@dimen/margin_4"
                android:layout_marginEnd="@dimen/margin_10">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/backupCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_8"
                    android:layout_marginTop="@dimen/margin_6"
                    android:layout_marginEnd="@dimen/margin_8"
                    android:layout_marginBottom="@dimen/margin_6"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/corner_radius_8"
                    app:cardElevation="@dimen/corner_elevation_2"
                    app:strokeColor="@color/card_shadow"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvBackup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_12"
                            android:layout_marginTop="@dimen/margin_12"
                            android:text="@string/backup"
                            android:textAllCaps="true"
                            android:textColor="@color/vibrant_orange"
                            android:textSize="@dimen/text_14"
                            app:drawableTint="@color/vibrant_orange"
                            app:fontFamily="@font/exo2_semibold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvBackup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_10"
                            android:layout_marginBottom="@dimen/margin_10"
                            android:background="@color/white"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>

            <!-- Others -->
            <RelativeLayout
                android:id="@+id/rlOthers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_10"
                android:layout_marginTop="@dimen/margin_4"
                android:layout_marginEnd="@dimen/margin_10">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/otherCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_8"
                    android:layout_marginTop="@dimen/margin_6"
                    android:layout_marginEnd="@dimen/margin_8"
                    android:layout_marginBottom="@dimen/margin_6"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/corner_radius_8"
                    app:cardElevation="@dimen/corner_elevation_2"
                    app:strokeColor="@color/card_shadow"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvOther"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_12"
                            android:layout_marginTop="@dimen/margin_12"
                            android:text="@string/others"
                            android:textAllCaps="true"
                            android:textColor="@color/vibrant_orange"
                            android:textSize="@dimen/text_14"
                            app:drawableTint="@color/vibrant_orange"
                            app:fontFamily="@font/exo2_semibold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvOthers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_10"
                            android:layout_marginBottom="@dimen/margin_10"
                            android:background="@color/white"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>