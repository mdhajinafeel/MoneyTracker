<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/corner_radius_12"
    app:cardElevation="@dimen/corner_elevation_4"
    app:strokeColor="@color/card_shadow"
    app:strokeWidth="0.4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/view_divider"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_12"
        android:paddingVertical="@dimen/padding_4"
        android:showDividers="middle">

        <!-- ================================================= -->
        <!-- Category                                         -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutCategory"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_8"
                android:src="@drawable/ic_category_outline"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/category"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end|center_vertical"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- Amount                                            -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutAmount"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_8"
                android:src="@drawable/ic_amount"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/lblAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/amount"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end|center_vertical"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- Received                                          -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutReceived"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_8"
                android:src="@drawable/ic_receive_amount"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/received_from_wallet"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvReceived"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end|center_vertical"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- Fee                                                -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutFee"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_8"
                android:src="@drawable/ic_fee_transfer"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/lblFee"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/fee"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvFee"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end|center_vertical"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- Recurring Repeat                                  -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutRepeatRecurring"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_8"
                android:src="@drawable/ic_transfer_trans"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/recurring"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvRepeatRecurring"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end|center_vertical"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- Frequency                                         -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutFrequency"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_8"
                android:src="@drawable/ic_refresh_time2"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/frequency"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvFrequency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end|center_vertical"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- Repeat Week                                       -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutRepeatWeek"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_10"
                android:src="@drawable/ic_calendar_weekly"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/week_day"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvRepeatWeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end|center_vertical"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- Repeat Time                                       -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutRepeatTime"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_10"
                android:src="@drawable/ic_time_solid"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/repeat_time"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvRepeatTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end|center_vertical"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- Next Run                                          -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutNextRunDate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="visible">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_10"
                android:src="@drawable/ic_calendar"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/next_recurring_text"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvNextRunDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end|center_vertical"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- Wallet                                             -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutWallet"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_10"
                android:src="@drawable/ic_wallet"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/wallet"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvWallet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end|center_vertical"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- Type                                               -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutType"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivType"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_8"
                android:src="@drawable/ic_income"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/type"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="@dimen/padding_8"
                android:paddingVertical="@dimen/padding_2"
                android:textAllCaps="true"
                android:textColor="@color/income"
                android:textSize="@dimen/text_12"
                app:fontFamily="@font/exo2_semibold" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- Status                                            -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutStatus"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivStatus"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_10"
                android:src="@drawable/ic_status"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/status"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="@dimen/padding_8"
                android:paddingVertical="@dimen/padding_2"
                android:textAllCaps="true"
                android:textColor="@color/income"
                android:textSize="@dimen/text_12"
                app:fontFamily="@font/exo2_semibold" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- Reminder                                          -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutReminder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivReminder"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_10"
                android:src="@drawable/ic_alert_2"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/reminder"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvReminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="@dimen/padding_8"
                android:paddingVertical="@dimen/padding_2"
                android:textAllCaps="true"
                android:textColor="@color/income"
                android:textSize="@dimen/text_12"
                app:fontFamily="@font/exo2_semibold" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- Create Transaction                                -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutCreateTransaction"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivCreateTransaction"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_10"
                android:src="@drawable/ic_transaction"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/create_transaction"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCreateTransaction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="@dimen/padding_8"
                android:paddingVertical="@dimen/padding_2"
                android:textAllCaps="true"
                android:textColor="@color/income"
                android:textSize="@dimen/text_12"
                app:fontFamily="@font/exo2_semibold" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- From Wallet                                        -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutFromWallet"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_10"
                android:src="@drawable/ic_wallet"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/from_wallet"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvFromWallet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end|center_vertical"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- To Wallet                                          -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutToWallet"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_10"
                android:src="@drawable/ic_wallet"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/to_wallet"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvToWallet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end|center_vertical"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- Description                                        -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutDescription"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_8"
                android:src="@drawable/ic_desc"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/description"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end|center_vertical"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- Note                                               -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/layoutNotes"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height_64"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_detail_icon"
                android:padding="@dimen/padding_10"
                android:src="@drawable/ic_note"
                android:tint="@color/primary_dark" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_weight="0.35"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/memo"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvNote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end|center_vertical"
                android:textColor="@color/color_matte_black"
                android:textSize="@dimen/text_14" />
        </LinearLayout>
    </LinearLayout>
