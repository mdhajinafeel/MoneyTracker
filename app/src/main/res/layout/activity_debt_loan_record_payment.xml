<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_light_background">

    <!-- Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/vibrant_orange"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar_back" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarWrapper">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDebtLoan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_10"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_radius_12"
                app:cardElevation="@dimen/corner_elevation_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/card_shadow"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_16"
                    android:layout_marginVertical="@dimen/margin_16">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardDebtLoanIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="@dimen/corner_radius_16"
                        app:cardElevation="0dp"
                        app:layout_constraintBottom_toBottomOf="@+id/leftWrapper"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/leftWrapper">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivDebtLoanIcon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:tint="@color/white" />
                    </com.google.android.material.card.MaterialCardView>

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guideline1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_begin="52dp" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/leftWrapper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_6"
                        android:layout_marginEnd="@dimen/margin_2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/guideline1"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvDebtLoanName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_8"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_16"
                            app:fontFamily="@font/exo2_semibold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvDebtType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_4"
                            android:background="@drawable/bg_badge_income"
                            android:drawablePadding="@dimen/padding_4"
                            android:drawableTint="@color/income"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/padding_8"
                            android:paddingVertical="@dimen/padding_2"
                            android:textAllCaps="true"
                            android:textColor="@color/income"
                            android:textSize="@dimen/text_10"
                            android:visibility="visible"
                            app:fontFamily="@font/exo2_semibold"
                            app:layout_constraintBottom_toBottomOf="@+id/tvDebtLoanName"
                            app:layout_constraintStart_toEndOf="@+id/tvDebtLoanName"
                            app:layout_constraintTop_toTopOf="@+id/tvDebtLoanName" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvDebtLoanTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_8"
                            android:layout_marginEnd="@dimen/margin_8"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_14"
                            app:fontFamily="@font/exo2_medium"
                            app:layout_constraintStart_toStartOf="@id/tvDebtLoanName"
                            app:layout_constraintTop_toBottomOf="@id/tvDebtLoanName" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/debtLoanAmountContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10"
                android:background="@drawable/bg_box_purple_stroke"
                android:paddingStart="@dimen/padding_10"
                android:paddingTop="@dimen/padding_6"
                android:paddingEnd="@dimen/padding_10"
                android:paddingBottom="@dimen/padding_6"
                app:layout_constraintEnd_toEndOf="@id/cardDebtLoan"
                app:layout_constraintStart_toStartOf="@id/cardDebtLoan"
                app:layout_constraintTop_toBottomOf="@id/cardDebtLoan">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/margin_6"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Partition 1 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/exo2_medium"
                            android:text="@string/total"
                            android:textColor="@color/dark_grey"
                            android:textSize="@dimen/text_12" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvTotalAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_4"
                            android:fontFamily="@font/exo2_semibold"
                            android:textColor="@color/color_matte_black"
                            android:textSize="@dimen/text_16" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="0.7dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="@dimen/margin_6"
                        android:background="@color/light_lavender" />

                    <!-- Partition 2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/exo2_medium"
                            android:text="@string/paid"
                            android:textColor="@color/dark_grey"
                            android:textSize="@dimen/text_12" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvPaidAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_4"
                            android:fontFamily="@font/exo2_semibold"
                            android:textColor="@color/color_matte_black"
                            android:textSize="@dimen/text_16" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="0.7dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="@dimen/margin_6"
                        android:background="@color/light_lavender" />

                    <!-- Partition 3 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/exo2_medium"
                            android:text="@string/remaining"
                            android:textColor="@color/dark_grey"
                            android:textSize="@dimen/text_12" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvRemainingAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_4"
                            android:fontFamily="@font/exo2_semibold"
                            android:textColor="@color/color_matte_black"
                            android:textSize="@dimen/text_16" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/debtLoanHintContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10"
                android:background="@drawable/bg_box_purple_stroke"
                android:paddingStart="@dimen/padding_10"
                android:paddingTop="@dimen/padding_6"
                android:paddingEnd="@dimen/padding_10"
                android:paddingBottom="@dimen/padding_6"
                app:layout_constraintEnd_toEndOf="@id/cardDebtLoan"
                app:layout_constraintStart_toStartOf="@id/cardDebtLoan"
                app:layout_constraintTop_toBottomOf="@id/debtLoanAmountContainer">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_10"
                    android:layout_marginVertical="@dimen/margin_6"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivReceive"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_circle_white"
                        android:padding="@dimen/padding_6"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_10"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivReceive"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/lblDebtLoanHintTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/exo2_semibold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_14" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/lblDebtLoanHintDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_2"
                            android:fontFamily="@font/exo2_medium"
                            android:textColor="@color/dark_grey"
                            android:textSize="@dimen/text_12" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInstallmentNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_10"
                app:cardCornerRadius="@dimen/corner_radius_12"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/debtLoanHintContainer"
                app:strokeColor="@color/card_shadow"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/padding_16"
                    android:paddingVertical="@dimen/padding_10">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivInstallment"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_theme"
                        android:padding="@dimen/padding_6"
                        android:src="@drawable/ic_number"
                        app:layout_constraintBottom_toBottomOf="@+id/layoutInstallment"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/layoutInstallment"
                        app:tint="@color/primary" />

                    <LinearLayout
                        android:id="@+id/layoutInstallment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_10"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/ivInstallmentSelect"
                        app:layout_constraintStart_toEndOf="@+id/ivInstallment"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/installment_no"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_14"
                            app:fontFamily="@font/exo2_bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvInstallment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_4"
                            android:ems="10"
                            android:fontFamily="@font/exo2_medium"
                            android:gravity="start|center_vertical"
                            android:layoutDirection="ltr"
                            android:textColor="@color/black"
                            android:textColorHint="@color/dark_grey"
                            android:textDirection="ltr"
                            android:textSize="@dimen/text_14" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivInstallmentSelect"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:visibility="gone"
                        android:src="@drawable/ic_account_caret"
                        app:layout_constraintBottom_toBottomOf="@+id/layoutInstallment"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/layoutInstallment"
                        app:tint="@color/primary" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPaymentDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_10"
                app:cardCornerRadius="@dimen/corner_radius_12"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardInstallmentNo"
                app:strokeColor="@color/card_shadow"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/padding_16"
                    android:paddingVertical="@dimen/padding_10">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivPaymentDate"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_theme"
                        android:padding="@dimen/padding_6"
                        android:src="@drawable/ic_calendar"
                        app:layout_constraintBottom_toBottomOf="@+id/layoutPaymentDate"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/layoutPaymentDate"
                        app:tint="@color/primary" />

                    <LinearLayout
                        android:id="@+id/layoutPaymentDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_10"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/ivPaymentSelect"
                        app:layout_constraintStart_toEndOf="@+id/ivPaymentDate"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_date"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_14"
                            app:fontFamily="@font/exo2_bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvPaymentDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_4"
                            android:ems="10"
                            android:fontFamily="@font/exo2_medium"
                            android:gravity="start|center_vertical"
                            android:layoutDirection="ltr"
                            android:textColor="@color/black"
                            android:textColorHint="@color/dark_grey"
                            android:textDirection="ltr"
                            android:textSize="@dimen/text_14" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivPaymentSelect"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_account_caret"
                        app:layout_constraintBottom_toBottomOf="@+id/layoutPaymentDate"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/layoutPaymentDate"
                        app:tint="@color/primary" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPaymentWallet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_10"
                app:cardCornerRadius="@dimen/corner_radius_12"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardPaymentDate"
                app:strokeColor="@color/card_shadow"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/padding_16"
                    android:paddingVertical="@dimen/padding_10">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivPaymentWallet"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_theme"
                        android:padding="@dimen/padding_6"
                        android:src="@drawable/ic_wallet"
                        app:layout_constraintBottom_toBottomOf="@+id/layoutPaymentWallet"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/layoutPaymentWallet"
                        app:tint="@color/primary" />

                    <LinearLayout
                        android:id="@+id/layoutPaymentWallet"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_10"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/ivPaymentWalletSelect"
                        app:layout_constraintStart_toEndOf="@+id/ivPaymentWallet"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/wallet"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_14"
                            app:fontFamily="@font/exo2_bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvPaymentWallet"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_4"
                            android:ems="10"
                            android:fontFamily="@font/exo2_medium"
                            android:gravity="start|center_vertical"
                            android:layoutDirection="ltr"
                            android:textColor="@color/black"
                            android:textColorHint="@color/dark_grey"
                            android:textDirection="ltr"
                            android:textSize="@dimen/text_16" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivPaymentWalletSelect"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_account_caret"
                        app:layout_constraintBottom_toBottomOf="@+id/layoutPaymentWallet"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/layoutPaymentWallet"
                        app:tint="@color/primary" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPaymentAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_10"
                app:cardCornerRadius="@dimen/corner_radius_12"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardPaymentWallet"
                app:strokeColor="@color/card_shadow"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/padding_16"
                    android:paddingVertical="@dimen/padding_10">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivPaymentAmount"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_theme"
                        android:padding="@dimen/padding_6"
                        android:src="@drawable/ic_amount"
                        app:layout_constraintBottom_toBottomOf="@+id/layoutPaymentAmount"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/layoutPaymentAmount"
                        app:tint="@color/primary" />

                    <LinearLayout
                        android:id="@+id/layoutPaymentAmount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_10"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/ivPaymentAmountSelect"
                        app:layout_constraintStart_toEndOf="@+id/ivPaymentAmount"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_amount"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_14"
                            app:fontFamily="@font/exo2_bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvPaymentAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_4"
                            android:ems="10"
                            android:fontFamily="@font/exo2_medium"
                            android:gravity="start|center_vertical"
                            android:layoutDirection="ltr"
                            android:textColor="@color/black"
                            android:textColorHint="@color/dark_grey"
                            android:textDirection="ltr"
                            android:textSize="@dimen/text_16" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivPaymentAmountSelect"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_account_caret"
                        app:layout_constraintBottom_toBottomOf="@+id/layoutPaymentAmount"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/layoutPaymentAmount"
                        app:tint="@color/primary" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_10"
                app:cardCornerRadius="@dimen/corner_radius_12"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardPaymentAmount"
                app:strokeColor="@color/card_shadow"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/padding_16"
                    android:paddingVertical="@dimen/padding_10">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivPaymentMethod"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_theme"
                        android:padding="@dimen/padding_6"
                        android:src="@drawable/ic_cash"
                        app:layout_constraintBottom_toBottomOf="@+id/layoutPaymentMethod"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/layoutPaymentMethod"
                        app:tint="@color/primary" />

                    <LinearLayout
                        android:id="@+id/layoutPaymentMethod"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_10"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/ivPaymentMethodSelect"
                        app:layout_constraintStart_toEndOf="@+id/ivPaymentMethod"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_method"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_14"
                            app:fontFamily="@font/exo2_bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvPaymentMethod"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_4"
                            android:ems="10"
                            android:fontFamily="@font/exo2_medium"
                            android:gravity="start|center_vertical"
                            android:layoutDirection="ltr"
                            android:textColor="@color/black"
                            android:textColorHint="@color/dark_grey"
                            android:textDirection="ltr"
                            android:textSize="@dimen/text_14" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivPaymentMethodSelect"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_account_caret"
                        app:layout_constraintBottom_toBottomOf="@+id/layoutPaymentMethod"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/layoutPaymentMethod"
                        app:tint="@color/primary" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <include
                android:id="@+id/cardReference"
                layout="@layout/layout_record_payment_reference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardPaymentMethod" />

            <include
                android:id="@+id/cardAttachment"
                layout="@layout/layout_record_payment_attachment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardReference" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_10"
                app:cardCornerRadius="@dimen/corner_radius_12"
                app:cardElevation="2dp"
                android:layout_marginBottom="@dimen/margin_10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardAttachment"
                app:strokeColor="@color/card_shadow"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/padding_16"
                    android:paddingVertical="@dimen/padding_10">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivNotes"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_theme"
                        android:padding="@dimen/padding_6"
                        android:src="@drawable/ic_note"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/primary" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/noteLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_10"
                        android:text="@string/notes"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_14"
                        app:fontFamily="@font/exo2_bold"
                        app:layout_constraintStart_toEndOf="@id/ivNotes"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etNotes"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/edit_text_height_40"
                        android:background="@drawable/bg_edit_text_underline"
                        android:ems="10"
                        android:fontFamily="@font/exo2_medium"
                        android:inputType="textCapWords"
                        android:maxLength="50"
                        android:paddingStart="@dimen/padding_0"
                        android:paddingEnd="@dimen/padding_16"
                        android:textColor="@color/black"
                        android:textColorHint="@color/dark_grey"
                        android:textSize="@dimen/text_14"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/noteLabel"
                        app:layout_constraintTop_toBottomOf="@id/noteLabel" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/maxLimitNotes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/funky_grey"
                        android:textSize="@dimen/text_8"
                        app:fontFamily="@font/exo2_semibold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/etNotes" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>