<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <!-- Goal Header -->
    <LinearLayout
        android:id="@+id/goalHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/padding_4"
        android:paddingBottom="@dimen/padding_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvGoalName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/exo2_bold"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_18" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvGoalAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4"
            android:fontFamily="@font/exo2_semibold"
            android:gravity="center"
            android:textColor="@color/funky_grey"
            android:textSize="@dimen/text_14" />
    </LinearLayout>

    <View
        android:id="@+id/viewDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/light_grey"
        app:layout_constraintTop_toBottomOf="@+id/goalHeader" />

    <!-- Add Money -->
    <LinearLayout
        android:id="@+id/optionAddMoney"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/padding_20"
        android:paddingTop="@dimen/padding_12"
        android:paddingEnd="@dimen/padding_20"
        android:paddingBottom="@dimen/padding_12"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/viewDivider">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_add_money"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/exo2_semibold"
                android:text="@string/add_money"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_16" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/add_savings"
                android:textColor="@color/text_grey"
                android:textSize="@dimen/text_12" />

        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/viewAddMoney"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/margin_16"
        android:background="@color/light_grey"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/optionAddMoney" />

    <!-- Withdraw Money -->
    <LinearLayout
        android:id="@+id/optionWithdrawal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/padding_20"
        android:paddingTop="@dimen/padding_12"
        android:paddingEnd="@dimen/padding_20"
        android:paddingBottom="@dimen/padding_12"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/viewAddMoney">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_withdrawal"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/exo2_semibold"
                android:text="@string/withdraw_money"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_16" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/withdraw_savings"
                android:textColor="@color/text_grey"
                android:textSize="@dimen/text_12" />

        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/viewWithdrawal"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/margin_16"
        android:background="@color/light_grey"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/optionWithdrawal" />

    <!-- View Details -->
    <LinearLayout
        android:id="@+id/optionViewDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/padding_20"
        android:paddingTop="@dimen/padding_12"
        android:paddingEnd="@dimen/padding_20"
        android:paddingBottom="@dimen/padding_12"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/viewWithdrawal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_view_eye"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/exo2_semibold"
                android:text="@string/view_details"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_16" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/view_goal_detail"
                android:textColor="@color/text_grey"
                android:textSize="@dimen/text_12" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/viewViewDetails"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/margin_16"
        android:background="@color/light_grey"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/optionViewDetails" />

    <!-- Edit -->
    <LinearLayout
        android:id="@+id/optionEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/padding_20"
        android:paddingTop="@dimen/padding_12"
        android:paddingEnd="@dimen/padding_20"
        android:paddingBottom="@dimen/padding_12"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/viewViewDetails">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_edit_solid"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/exo2_semibold"
                android:text="@string/edit_goal"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_16" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/edit_goal_detail"
                android:textColor="@color/text_grey"
                android:textSize="@dimen/text_12" />

        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/viewEdit"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/margin_16"
        android:background="@color/light_grey"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/optionEdit" />

    <!-- Mark Completed -->
    <LinearLayout
        android:id="@+id/optionComplete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/padding_20"
        android:paddingTop="@dimen/padding_12"
        android:paddingEnd="@dimen/padding_20"
        android:paddingBottom="@dimen/padding_12"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/viewEdit">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_achieved"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/exo2_semibold"
                android:text="@string/mark_achieved"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_16" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/finish_goal"
                android:textColor="@color/text_grey"
                android:textSize="@dimen/text_12" />

        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/viewComplete"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/margin_16"
        android:background="@color/light_grey"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/optionComplete" />

    <!-- Mark In Progress -->
    <LinearLayout
        android:id="@+id/optionProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/padding_20"
        android:paddingTop="@dimen/padding_12"
        android:paddingEnd="@dimen/padding_20"
        android:paddingBottom="@dimen/padding_12"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/optionComplete">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_in_progress"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/exo2_semibold"
                android:text="@string/move_progress"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_16" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/move_back_progress"
                android:textColor="@color/text_grey"
                android:textSize="@dimen/text_12" />

        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/viewProgress"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/margin_16"
        android:background="@color/light_grey"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/optionProgress" />

    <!-- Restore -->
    <LinearLayout
        android:id="@+id/optionRestore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/padding_20"
        android:paddingTop="@dimen/padding_12"
        android:paddingEnd="@dimen/padding_20"
        android:paddingBottom="@dimen/padding_12"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/optionProgress">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_restore"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/exo2_semibold"
                android:text="@string/restore_goal"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_16" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/move_back"
                android:textColor="@color/text_grey"
                android:textSize="@dimen/text_12" />

        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/viewRestore"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/margin_16"
        android:background="@color/light_grey"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/optionRestore" />

    <!-- Archived -->
    <LinearLayout
        android:id="@+id/optionArchive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/padding_20"
        android:paddingTop="@dimen/padding_12"
        android:paddingEnd="@dimen/padding_20"
        android:paddingBottom="@dimen/padding_12"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/viewRestore">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_archive"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/exo2_semibold"
                android:text="@string/archived"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_16" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2"
                android:fontFamily="@font/exo2_medium"
                android:text="@string/archived_move"
                android:textColor="@color/text_grey"
                android:textSize="@dimen/text_12" />

        </LinearLayout>
    </LinearLayout>

    <!-- Divider before Delete -->
    <View
        android:id="@+id/viewLineDelete"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/margin_16"
        android:background="@color/light_grey"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/optionArchive" />

    <!-- Delete -->
    <LinearLayout
        android:id="@+id/optionDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/padding_20"
        android:paddingTop="@dimen/padding_12"
        android:paddingEnd="@dimen/padding_20"
        android:paddingBottom="@dimen/padding_12"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/viewLineDelete">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_delete_solid"
            app:tint="@color/delete_red" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/exo2_semibold"
            android:text="@string/delete_goal"
            android:textColor="@color/delete_red"
            android:textSize="@dimen/text_16"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>