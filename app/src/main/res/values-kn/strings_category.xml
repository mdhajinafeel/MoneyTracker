    <plurals name="category_in_use_message">
        <item quantity="one">"%1$s" ಅನ್ನು 1 ವಹಿವಾಟಿನಲ್ಲಿ ಬಳಸಲಾಗಿದೆ. ಆದ್ದರಿಂದ ಅದನ್ನು ಅಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ.\n\nವರ್ಗ ಸಂಪಾದಿಸಿ ಆಯ್ಕೆಯಿಂದ ಈ ವರ್ಗವನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಬಹುದು.</item>
        <item quantity="other">"%1$s" ಅನ್ನು %2$d ವಹಿವಾಟುಗಳಲ್ಲಿ ಬಳಸಲಾಗಿದೆ. ಆದ್ದರಿಂದ ಅದನ್ನು ಅಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ.\n\nವರ್ಗ ಸಂಪಾದಿಸಿ ಆಯ್ಕೆಯಿಂದ ಈ ವರ್ಗವನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಬಹುದು.</item>
    </plurals>

    <plurals name="move_category_desc">
