<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- For Android 12 and lower -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />

    <!-- For Android 13+ -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        android:required="false"
        tools:ignore="PhotoAndVideoPolicy" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        android:required="false"
        tools:ignore="PhotoAndVideoPolicy" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- For Android 14+ (Selected Photos Access) -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        android:required="false"
        tools:ignore="SelectedPhotoAccess" />

    <!-- Camera access -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Camera hardware optional -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Needed for Downloads folder on Android 10+ -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="AllFilesAccessPolicy,ScopedStorage" />

    <!-- Other permission -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MoneyTrackerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_mt_icon"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@drawable/ic_mt_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoneyTracker"
        tools:targetApi="31">

        <!-- Splash screen -->
        <activity
            android:name=".ui.activities.SplashActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Add Account Screen -->
        <activity
            android:name=".ui.activities.AddAccountActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Currency Screen -->
        <activity
            android:name=".ui.activities.CurrencyListActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Screen -->
        <activity
            android:name=".ui.activities.MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Transaction Screen -->
        <activity
            android:name=".ui.activities.CreateTransactionActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Transaction Detail Screen -->
        <activity
            android:name=".ui.activities.TransactionDetailActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Calculator Screen -->
        <activity
            android:name=".ui.activities.CalculatorActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Category Picker Screen -->
        <activity
            android:name=".ui.activities.CategoryPickerActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Create Wallet Screen -->
        <activity
            android:name=".ui.activities.CreateWalletActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Wallet Icon Picker Screen -->
        <activity
            android:name=".ui.activities.WalletPickerActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Wallet Transaction Detailed Screen -->
        <activity
            android:name=".ui.activities.WalletTransactionDetailedActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Add Currency Screen -->
        <activity
            android:name=".ui.activities.AddCurrencyActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Settings Screen -->
        <activity
            android:name=".ui.activities.SettingsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Manage Category Screen -->
        <activity
            android:name=".ui.activities.ManageCategoryActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Transaction Overview Screen -->
        <activity
            android:name=".ui.activities.TransactionOverviewActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Transaction Breakdown Screen -->
        <activity
            android:name=".ui.activities.TransactionBreakdownActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Transaction Period Screen -->
        <activity
            android:name=".ui.activities.TransactionPeriodActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Firebase Crashlytics -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="true" />

        <!-- File Providers -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>